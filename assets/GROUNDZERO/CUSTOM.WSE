item: Edit INI File
  Pathname=%MAINDIR%\WORLDS.INI
  Settings=[InstalledWorlds]
  Settings=InstalledWorld0=%HOMEWORLD%
  Settings=InstalledWorld%WORLDNUM%=%LASTWORLD%
