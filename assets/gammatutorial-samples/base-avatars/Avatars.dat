# animation registry version 0.3
version 3                               # keep this around

# New avatars:
#     aggie, female with short hair & dress
#     aura, female with ponytail, pants & boots
#     axel, male with short hair, white tee
#     guru, male guru with long white beard
#     mark, grey-haired man with striped tee
#     chloe, female with blue dress & sunglasses
#     habib, male with dreadlocks
#     joker, Black & white court jester
#     dude, surfer dude
#     tony, male with suit & sunglasses
#     sonya, woman with long coat
#     sunshine, female flower child
#     shamaness, woodwitch
#
# Original avatars:
#     barbra, female, tourist outfit
#     birdie, bird
#     hotep, jungle guy
#     shanubia, woman in long slinky dress
#     shred, surfer dude with board
#     willy, little boy with baseball cap
#
# Creature avatars:
#     achoo, the dinosaur
#     macaw, a bird of sorts
#     elf, a little guy
#     demon, a cone headed demon
#     barrelman, where are his clothes?
#     monster, devilish with big horns
#     orangutan, big sad eyed primate
#     creature, salamander on steroids
#     ogre, great big warrior
#     bigfoot, big and ape like
#     glubber, an escapee from the x-files
#     bitman, made up of bits and pieces
#     pilgrim, a pilgrim-like from thanksgiving dinner
#     graduate, a recent grad
#     drummajor, the leader of the band
#     cartoonman, a happy little guy with glasses
#     boxman, the unknown avatar made of boxes
#     death, the grim reaper-catch ya later!
#     roundman, small and round-spokesman for the new millennium
#
# More creatures:
#     lizard, the jesus lizard
#     spin, a dinosaur
#     rap, another dino
#     kangaroo, a hopping mammal
#     sty, dinosaur speak for little tank
#     nightglyder, a man-bat mix
#     pegasus, horse with wings
#     quail, a little bird like thingy thing
#     puffin, almost completely unlike a penguin
#     toucan, you know what they say about birds with big beaks eh?
#     crane, so much more than just a radio host
#     penguin, brrr... cold
#     bluepenguin, a penguin of a different color
#     kiwibird, like a kiwi fruit with legs
#     prince, asian horned frog
#     leo, leopard frog (he eats 'em for breakfast)
#     horny, ornate horned frog
#
# More people:
#     zita
#     jon
#     ray
#     jenny
#     amy
#
# New geometrix:
#     cassius
#     elfin
#     golem
#     john
#     loopy
#     mesmerist
#     somgirl
#     somguy
#     tina
#
# charlie


#=================================
# New Avatars
#=================================

avatar
  name=Aggie
  geometry=aggie.rwx
  beginimp
    walk=common_walk
#   walk2=common_walk2 mocap
#   walk3=common_walk3 bounce  
    wait=common_a_wait
    endwait=common_a_endwait
  endimp
  beginexp
    wave=common_a_wave
    dance=common_a_dance2
    yes=common_a_yes
    rocknroll=common_a_funky2
    no=common_a_no3
    macarena=common_a_macarena3
    happy=common_happy
    pirouette=common_y_ballet2
    upset=common_y_angry
    twirl=common_a_spin2
    getLost=common_getLost
    achoo=common_a_sneeze2
    look=common_a_look
    bow=common_a_bow
    flip=common_a_flip2
    quicknap=aurasleeping
  endexp
endavatar

