# Ghidra installation (external tool, ~1.4GB) - reinstall from ghidra-sre.org
/ghidra_*_PUBLIC*/
/ghidra_*_PUBLIC*.zip

# Ghidra headless analysis project cache (regenerable from move/bin/*.dll,
# see docs/gamma-dll-exports.txt and docs/renderware21-api-exports.txt for
# the extracted results that ARE kept under version control)
/analysis/

# WorldsPlayer editor build output
editor/worldsplayer_source_editor-main/out/

# Portable JDK for macOS (Temurin tar.gz from api.adoptium.net, installed by
# tools/setup-macos.sh - Homebrew no longer supports Intel Macs)
/tools/jdk/

# Git worktrees that the Claude Code harness creates for background agents
/.claude/worktrees/

# Build output of the formats/ readers (tools/setup-linux.sh, setup-macos.sh)
/formats/out/

# Local leftovers of the new engine, removed on 2026-09-26 (LWJGL, node and
# the RWX harness, its build and its logs): still ignored so that a checkout
# that still has them doesn't commit them by mistake.
/tools/lwjgl/
/tools/node/
/tools/node-macos/
/tools/rwx-harness/
/client/
/logs/

# Third-party documentation (Worlds Inc.'s official GammaDocs, provided
# directly by the user, mirrored via HTTrack from dev.worlds.net/private/
# GammaDocs) - kept locally for reference, not versioned: it's not our
# content and most of it (interface mockups, unrelated HTML pages) was
# never actually used. The specific facts cited from it are paraphrased
# with attribution in docs/rwg-bod-format-reference.md instead. The 4
# real .rwg/.rwx binary format samples it contained (genuine test
# corpus, not documentation) were moved out to
# assets/gammatutorial-samples/ before this rule was added, so they
# stay versioned.
/GammaDocs/
GammaDocs.zip

# Download-log bookkeeping inside the real WorldsPlayer install's cache
# dir (assets/WorldsPlayer/cachedir/) - timestamps/URLs of what was
# fetched from where, not format/geometry data. The actual downloaded
# content in that same directory (.bod/.seq/.mov/.cmp - real avatar
# assets used as verified test corpus, see docs/rwg-bod-format-reference.md)
# stays versioned; only this bookkeeping is excluded.
assets/WorldsPlayer/cachedir/*.LOG
# cache.index is NOT ignored: without it the original client can't find the
# cached avatars (see CLAUDE.md, open item 0)
assets/WorldsPlayer/cachedir/*.lst

__pycache__/
*.pyc

# macOS (Finder + Xcode + ARM/x86 universal noise) — none of this is versioned
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon?
*.dmg
*.pkg

# Build of the original client with the portable bridge (build_gamma.sh)
editor/.build-gamma/

# build/dist + the native app from tools/build-dist.sh (and its classes)
/build/
