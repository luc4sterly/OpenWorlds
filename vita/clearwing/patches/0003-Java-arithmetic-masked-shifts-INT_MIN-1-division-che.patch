diff --git a/runtime/res/clearwing/src/Double.cpp b/runtime/res/clearwing/src/Double.cpp
index d6a080e..455a189 100644
--- a/runtime/res/clearwing/src/Double.cpp
+++ b/runtime/res/clearwing/src/Double.cpp
@@ -2,6 +2,66 @@
 
 #include <cstring>
 
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+// Java's Double/Float.toString for a finite nonzero value: the shortest digits
+// that read back as the same value, in plain notation for 1e-3 <= |v| < 1e7
+// and as d.dddE<n> otherwise, always with a digit after the point.
+static void javaFloatingToString(char *out, double value, bool isFloat, bool scientific) {
+    char buf[48];
+    int maxDigits = isFloat ? 9 : 17;
+    for (int p = 1; p <= maxDigits; p++) {
+        snprintf(buf, sizeof buf, "%.*e", p - 1, value);
+        if (isFloat ? strtof(buf, nullptr) == (float) value : strtod(buf, nullptr) == value)
+            break;
+    }
+    // buf: [-]d[.ddd]e(+|-)xx
+    char digits[24];
+    int n = 0;
+    const char *c = buf;
+    bool negative = *c == '-';
+    if (negative)
+        c++;
+    for (; *c && *c != 'e'; c++)
+        if (*c >= '0' && *c <= '9')
+            digits[n++] = *c;
+    int exponent = atoi(c + 1);
+    while (n > 1 && digits[n - 1] == '0')
+        n--;
+    char *o = out;
+    if (negative)
+        *o++ = '-';
+    if (scientific) {
+        *o++ = digits[0];
+        *o++ = '.';
+        if (n > 1)
+            for (int i = 1; i < n; i++)
+                *o++ = digits[i];
+        else
+            *o++ = '0';
+        o += sprintf(o, "E%d", exponent);
+    } else if (exponent >= 0) {
+        for (int i = 0; i <= exponent; i++)
+            *o++ = i < n ? digits[i] : '0';
+        *o++ = '.';
+        if (n > exponent + 1)
+            for (int i = exponent + 1; i < n; i++)
+                *o++ = digits[i];
+        else
+            *o++ = '0';
+    } else {
+        *o++ = '0';
+        *o++ = '.';
+        for (int i = 0; i < -exponent - 1; i++)
+            *o++ = '0';
+        for (int i = 0; i < n; i++)
+            *o++ = digits[i];
+    }
+    *o = 0;
+}
+
 extern "C" {
 
 jlong SM_java_lang_Double_doubleToLongBits_double_R_long(jcontext ctx, jdouble value) {
@@ -17,57 +77,8 @@ jdouble SM_java_lang_Double_longBitsToDouble_long_R_double(jcontext ctx, jlong v
 }
 
 jobject SM_java_lang_Double_toStringImpl_double_boolean_R_java_lang_String(jcontext ctx, jdouble d, jbool b) {
-    char s[32]{};
