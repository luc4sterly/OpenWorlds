 NORETURN void throwDivisionByZero(jcontext ctx);
+
+// Java's integer arithmetic: shift counts masked, INT_MIN / -1 wraps, x / 0 throws.
+inline jint javaShl(jint a, jint n) { return (jint) ((uint32_t) a << (n & 31)); }
+inline jint javaShr(jint a, jint n) { return a >> (n & 31); }
+inline jint javaUshr(jint a, jint n) { return (jint) ((uint32_t) a >> (n & 31)); }
+inline jlong javaShl(jlong a, jint n) { return (jlong) ((uint64_t) a << (n & 63)); }
+inline jlong javaShr(jlong a, jint n) { return a >> (n & 63); }
+inline jlong javaUshr(jlong a, jint n) { return (jlong) ((uint64_t) a >> (n & 63)); }
+inline jint javaDiv(jcontext ctx, jint a, jint b) {
+    if (b == 0) throwDivisionByZero(ctx);
+    return b == -1 ? (jint) (0u - (uint32_t) a) : a / b;
+}
+inline jint javaRem(jcontext ctx, jint a, jint b) {
+    if (b == 0) throwDivisionByZero(ctx);
+    return b == -1 ? 0 : a % b;
+}
+inline jlong javaDiv(jcontext ctx, jlong a, jlong b) {
+    if (b == 0) throwDivisionByZero(ctx);
+    return b == -1 ? (jlong) (0ull - (uint64_t) a) : a / b;
+}
+inline jlong javaRem(jcontext ctx, jlong a, jlong b) {
+    if (b == 0) throwDivisionByZero(ctx);
+    return b == -1 ? 0 : a % b;
+}
+// Java's float to integer conversions: NaN is 0, out of range saturates.
+inline jint javaF2I(jfloat f) { return f != f ? 0 : f >= 2147483648.0f ? 0x7fffffff : f <= -2147483648.0f ? (jint) 0x80000000 : (jint) f; }
+inline jint javaD2I(jdouble d) { return d != d ? 0 : d >= 2147483647.0 ? 0x7fffffff : d <= -2147483648.0 ? (jint) 0x80000000 : (jint) d; }
+inline jlong javaF2L(jfloat f) { return f != f ? 0 : f >= 9223372036854775808.0f ? 0x7fffffffffffffffll : f <= -9223372036854775808.0f ? (jlong) 0x8000000000000000ull : (jlong) f; }
+inline jlong javaD2L(jdouble d) { return d != d ? 0 : d >= 9223372036854775808.0 ? 0x7fffffffffffffffll : d <= -9223372036854775808.0 ? (jlong) 0x8000000000000000ull : (jlong) d; }
 NORETURN void throwClassCast(jcontext ctx);
 NORETURN void throwNullPointer(jcontext ctx);
 NORETURN void throwStackOverflow(jcontext ctx);
