+jarray createMainArguments(jcontext ctx) {
+    int count = mainArgc > 1 ? mainArgc - 1 : 0;
+    auto array = createArray(ctx, &class_java_lang_String, count);
+    for (int i = 0; i < count; i++)
+        ((jobject *) array->data)[i] = (jobject) stringFromNative(ctx, mainArgv[i + 1]);
+    return array;
+}
+
+/// As a JVM: once main returns, the program goes on while a thread that is not a daemon runs (an AWT program's event thread).
+static void waitForNonDaemonThreads(jcontext mainContext) {
+    while (!exiting) {
+        bool running = false;
+        acquireCriticalLock();
+        for (auto threadContext : threadContexts) {
+            if (threadContext == mainContext || threadContext->dead)
+                continue;
+            auto thread = threadContext->thread;
+            if (thread && thread != collectionThread && thread->F_alive && !thread->F_daemon)
+                running = true;
+        }
+        releaseCriticalLock();
+        if (!running)
+            break;
+        std::this_thread::sleep_for(std::chrono::milliseconds(50));
+    }
+}
