From cc452cc5e545e69f08b66c31409088892c927364 Mon Sep 17 00:00:00 2001
From: OpenWorlds <openworlds@localhost>
Date: Thu, 8 Oct 2026 16:29:08 +0000
Subject: [PATCH] Natives of RandomAccessFile, FileChannel and Files only when
 those classes are transpiled

---
 runtime/res/clearwing/src/NioFiles.cpp         |  4 ++++
 runtime/res/clearwing/src/RandomAccessFile.cpp | 14 +++++++++++++-
 2 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/runtime/res/clearwing/src/NioFiles.cpp b/runtime/res/clearwing/src/NioFiles.cpp
index 5c1adce..71fa34c 100644
--- a/runtime/res/clearwing/src/NioFiles.cpp
+++ b/runtime/res/clearwing/src/NioFiles.cpp
@@ -1,3 +1,5 @@
+// Only when the program uses java.nio.file.Files (natives of classes it does not use are not built)
+#if __has_include("java/nio/file/Files.h")
 #include "java/nio/file/Files.h"
 #include "java/lang/String.h"
 
@@ -13,3 +15,5 @@ jlong SM_java_nio_file_Files_device0_java_lang_String_R_long(jcontext ctx, jobje
 }
 
 }
+
+#endif
diff --git a/runtime/res/clearwing/src/RandomAccessFile.cpp b/runtime/res/clearwing/src/RandomAccessFile.cpp
index 883bfaf..9441a41 100644
--- a/runtime/res/clearwing/src/RandomAccessFile.cpp
+++ b/runtime/res/clearwing/src/RandomAccessFile.cpp
@@ -1,5 +1,12 @@
+// Only for the classes the program uses (natives of classes it does not use are not built)
+#if __has_include("java/io/RandomAccessFile.h")
 #include "java/io/RandomAccessFile.h"
+#define HAS_RANDOM_ACCESS_FILE 1
+#endif
+#if __has_include("java/nio/channels/FileChannel.h")
 #include "java/nio/channels/FileChannel.h"
+#define HAS_FILE_CHANNEL 1
+#endif
 #include "java/lang/String.h"
 
 #include <cerrno>
@@ -13,12 +20,13 @@
 
 // RandomAccessFile on C stdio; reads and writes let the collector run meanwhile.
 
-static FILE *fileOf(jlong handle) {
+[[maybe_unused]] static FILE *fileOf(jlong handle) {
     return (FILE *) (intptr_t) handle;
 }
 
 extern "C" {
 
+#if HAS_RANDOM_ACCESS_FILE
 jlong SM_java_io_RandomAccessFile_open0_java_lang_String_boolean_R_long(jcontext ctx, jobject path, jbool rw) {
     auto p = stringToNative(ctx, (jstring) NULL_CHECK(path));
     FILE *f = fopen(p, rw ? "r+b" : "rb");
@@ -85,6 +93,9 @@ void SM_java_io_RandomAccessFile_close0_long(jcontext ctx, jlong handle) {
         fclose(fileOf(handle));
 }
 
+#endif
+
+#if HAS_FILE_CHANNEL
 jbool SM_java_nio_channels_FileChannel_lock0_int_boolean_R_boolean(jcontext ctx, jint fd, jbool shared) {
 #if defined(__vita__)
     return true;
@@ -98,5 +109,6 @@ void SM_java_nio_channels_FileChannel_unlock0_int(jcontext ctx, jint fd) {
     flock(fd, LOCK_UN);
 #endif
 }
+#endif
 
 }
-- 
2.43.0

