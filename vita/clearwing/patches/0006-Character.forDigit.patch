From 130caa78cf711ef1a100b7c53d39940bdc37c2e5 Mon Sep 17 00:00:00 2001
From: OpenWorlds <openworlds@localhost>
Date: Tue, 6 Oct 2026 15:24:57 +0000
Subject: [PATCH 06/13] Character.forDigit

---
 runtime/src/java/lang/Character.java | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/runtime/src/java/lang/Character.java b/runtime/src/java/lang/Character.java
index aadcdb8..c5090ed 100644
--- a/runtime/src/java/lang/Character.java
+++ b/runtime/src/java/lang/Character.java
@@ -238,6 +238,12 @@ public final class Character implements Comparable<Character>{
     /**
      * Returns the numeric value of the character ch in the specified radix.
      */
+    public static char forDigit(int digit, int radix) {
+        if (digit < 0 || digit >= radix || radix < Character.MIN_RADIX || radix > Character.MAX_RADIX)
+            return '\0';
+        return (char) (digit < 10 ? '0' + digit : 'a' - 10 + digit);
+    }
+
     public static int digit(char ch, int radix){
         return digit((int) ch, radix);
     }
