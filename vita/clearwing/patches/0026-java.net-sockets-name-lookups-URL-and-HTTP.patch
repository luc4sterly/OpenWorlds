diff --git a/runtime/src/java/net/PlainSocketImpl.java b/runtime/src/java/net/PlainSocketImpl.java
new file mode 100644
index 0000000..0f3ce64
--- /dev/null
+++ b/runtime/src/java/net/PlainSocketImpl.java
@@ -0,0 +1,80 @@
+package java.net;
+
+import java.io.IOException;
+
+/**
+ * The BSD socket calls under Socket and ServerSocket (IPv4, TCP). Blocking
+ * calls let the collector run meanwhile. Errors come back as negative
+ * errno values and become the JDK's exceptions here.
+ */
+final class PlainSocketImpl {
+   private PlainSocketImpl() {
+   }
+
+   static final int TCP_NODELAY = 1;
+   static final int SO_KEEPALIVE = 2;
+   static final int SO_LINGER = 3;
+   static final int SO_RCVBUF = 4;
+   static final int SO_SNDBUF = 5;
+   static final int SO_REUSEADDR = 6;
+
+   /** What a negative result means (errnoKind). */
+   static final int OTHER = 0;
+   static final int REFUSED = 1;
+   static final int TIMED_OUT = 2;
+   static final int UNREACHABLE = 3;
+   static final int IN_USE = 4;
+   static final int WOULD_BLOCK = 5;
+   static final int RESET = 6;
+   static final int BROKEN_PIPE = 7;
+
+   static native int socket0();
+
+   /** 0, or a negative errno; the timeout in milliseconds (0: none). */
+   static native int connect0(int fd, byte[] address, int port, int timeout);
+
+   /** Bytes read, 0 at the end of the stream (with len > 0), or a negative errno; -ETIMEDOUT after timeout ms. */
+   static native int read0(int fd, byte[] b, int off, int len, int timeout);
+
+   static native int write0(int fd, byte[] b, int off, int len);
+
+   static native int available0(int fd);
+
+   static native void close0(int fd);
+
+   static native int shutdown0(int fd, int how);
+
+   static native int bind0(int fd, byte[] address, int port);
+
+   static native int listen0(int fd, int backlog);
+
+   /** The new descriptor, the peer in address and port[0]; a negative errno (-ETIMEDOUT after timeout ms). */
+   static native int accept0(int fd, int timeout, byte[] address, int[] port);
+
+   static native int localPort0(int fd);
+
+   static native void localAddress0(int fd, byte[] address);
+
+   static native int setOption0(int fd, int option, int value);
+
+   static native int errnoKind(int err);
+
+   static native String errorText(int err);
+
+   static IOException exception(int result, String context) {
+      int kind = errnoKind(-result);
+      String text = errorText(-result) + (context != null ? " (" + context + ")" : "");
+      switch (kind) {
+         case REFUSED:
+            return new ConnectException("Connection refused" + (context != null ? " (" + context + ")" : ""));
+         case TIMED_OUT:
+            return new SocketTimeoutException(context != null && context.startsWith("connect") ? "connect timed out" : "Read timed out");
+         case UNREACHABLE:
+            return new NoRouteToHostException(text);
+         case IN_USE:
+            return new BindException(text);
+         default:
+            return new SocketException(text);
+      }
+   }
+}
diff --git a/runtime/src/java/net/ServerSocket.java b/runtime/src/java/net/ServerSocket.java
new file mode 100644
index 0000000..5eb2544
--- /dev/null
+++ b/runtime/src/java/net/ServerSocket.java
@@ -0,0 +1,137 @@
+package java.net;
+
+import java.io.IOException;
+
+/** A TCP server socket (IPv4), as java.net.ServerSocket. */
+public class ServerSocket implements java.io.Closeable {
+   private int fd = -1;
+   private boolean bound;
+   private boolean closed;
+   private int soTimeout;
+   private InetAddress bindAddress;
+   private final Object closeLock = new Object();
+
+   public ServerSocket() throws IOException {
+   }
+
+   public ServerSocket(int port) throws IOException {
+      this(port, 50, null);
+   }
+
+   public ServerSocket(int port, int backlog) throws IOException {
+      this(port, backlog, null);
+   }
+
+   public ServerSocket(int port, int backlog, InetAddress bindAddr) throws IOException {
+      if (port < 0 || port > 0xFFFF)
+         throw new IllegalArgumentException("Port value out of range: " + port);
+      try {
+         bind(new InetSocketAddress(bindAddr != null ? bindAddr : InetAddress.getByAddress(new byte[4]), port), backlog);
+      } catch (IOException e) {
+         close();
+         throw e;
+      }
+   }
+
+   public void bind(SocketAddress endpoint) throws IOException {
+      bind(endpoint, 50);
+   }
+
+   public void bind(SocketAddress endpoint, int backlog) throws IOException {
+      if (isClosed())
+         throw new SocketException("Socket is closed");
+      if (bound)
+         throw new SocketException("Already bound");
+      InetSocketAddress ep = endpoint != null ? (InetSocketAddress) endpoint : new InetSocketAddress(0);
+      if (ep.isUnresolved())
+         throw new SocketException("Unresolved address");
+      if (backlog < 1)
+         backlog = 50;
+      int s = PlainSocketImpl.socket0();
+      if (s < 0)
+         throw PlainSocketImpl.exception(s, null);
+      fd = s;
+      PlainSocketImpl.setOption0(fd, PlainSocketImpl.SO_REUSEADDR, 1);
+      byte[] raw = ep.getAddress().getAddress();
+      int r = PlainSocketImpl.bind0(fd, raw, ep.getPort());
+      if (r < 0)
+         throw PlainSocketImpl.exception(r, "Address already in use");
+      r = PlainSocketImpl.listen0(fd, backlog);
+      if (r < 0)
+         throw PlainSocketImpl.exception(r, null);
+      bindAddress = ep.getAddress();
+      bound = true;
+   }
+
+   public InetAddress getInetAddress() {
+      return bound ? bindAddress : null;
+   }
+
+   public int getLocalPort() {
+      return bound ? PlainSocketImpl.localPort0(fd) : -1;
+   }
+
+   public SocketAddress getLocalSocketAddress() {
+      return bound ? new InetSocketAddress(bindAddress, getLocalPort()) : null;
+   }
+
+   public Socket accept() throws IOException {
+      if (isClosed())
+         throw new SocketException("Socket is closed");
+      if (!bound)
+         throw new SocketException("Socket is not bound yet");
+      byte[] addr = new byte[4];
+      int[] port = new int[1];
+      int s = PlainSocketImpl.accept0(fd, soTimeout, addr, port);
+      if (s < 0) {
+         if (isClosed())
+            throw new SocketException("Socket closed");
+         int kind = PlainSocketImpl.errnoKind(-s);
+         if (kind == PlainSocketImpl.TIMED_OUT)
+            throw new SocketTimeoutException("Accept timed out");
+         throw PlainSocketImpl.exception(s, null);
+      }
+      return new Socket(s, InetAddress.getByAddress(addr), port[0]);
+   }
+
+   public void close() throws IOException {
+      synchronized (closeLock) {
+         if (closed)
+            return;
+         closed = true;
+      }
+      if (fd >= 0)
+         PlainSocketImpl.close0(fd);
+   }
+
+   public boolean isBound() {
+      return bound;
+   }
+
+   public boolean isClosed() {
+      synchronized (closeLock) {
+         return closed;
+      }
+   }
+
+   public synchronized void setSoTimeout(int timeout) throws SocketException {
+      if (isClosed())
+         throw new SocketException("Socket is closed");
+      if (timeout < 0)
+         throw new IllegalArgumentException("timeout < 0");
+      soTimeout = timeout;
+   }
+
+   public synchronized int getSoTimeout() throws IOException {
+      return soTimeout;
+   }
+
+   public void setReuseAddress(boolean on) throws SocketException {
+   }
+
+   public String toString() {
+      if (!bound)
+         return "ServerSocket[unbound]";
+      return "ServerSocket[addr=" + bindAddress + ",localport=" + getLocalPort() + "]";
+   }
+}
