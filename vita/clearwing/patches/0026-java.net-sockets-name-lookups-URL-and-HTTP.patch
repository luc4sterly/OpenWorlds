--- /dev/null
+++ b/runtime/src/java/net/Inet4AddressImpl.java
@@ -0,0 +1,56 @@
+package java.net;
+
+import java.io.IOException;
+
+/** Name lookups for IPv4 with the platform's resolver (getaddrinfo, getnameinfo). */
+final class Inet4AddressImpl implements InetAddressImpl {
+   public String getLocalHostName() throws UnknownHostException {
+      String name = localHostName0();
+      return name != null ? name : "localhost";
+   }
+
+   public InetAddress[] lookupAllHostAddr(String host) throws UnknownHostException {
+      byte[][] found = lookup0(host);
+      if (found == null || found.length == 0)
+         throw new UnknownHostException(host);
+      InetAddress[] out = new InetAddress[found.length];
+      for (int i = 0; i < found.length; i++)
+         out[i] = new Inet4Address(host, found[i]);
+      return out;
+   }
+
+   public String getHostByAddr(byte[] addr) throws UnknownHostException {
+      String name = hostByAddr0(addr);
+      if (name == null)
+         throw new UnknownHostException();
+      return name;
+   }
+
+   public InetAddress anyLocalAddress() {
+      return new Inet4Address(null, new byte[]{0, 0, 0, 0});
+   }
+
+   public InetAddress loopbackAddress() {
+      return new Inet4Address("localhost", new byte[]{127, 0, 0, 1});
+   }
+
+   /** As the JDK without privileges: a TCP connection to the echo port answers (accepted or refused). */
+   public boolean isReachable(InetAddress addr, int timeout, NetworkInterface netif, int ttl) throws IOException {
+      int fd = PlainSocketImpl.socket0();
+      if (fd < 0)
+         return false;
+      try {
+         int r = PlainSocketImpl.connect0(fd, addr.getAddress(), 7, timeout);
+         return r == 0 || PlainSocketImpl.errnoKind(-r) == PlainSocketImpl.REFUSED;
+      } finally {
+         PlainSocketImpl.close0(fd);
+      }
+   }
+
+   private static native String localHostName0();
+
+   /** The IPv4 addresses of a name, null if it has none. */
+   private static native byte[][] lookup0(String host);
+
+   private static native String hostByAddr0(byte[] addr);
+}
