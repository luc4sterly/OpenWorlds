+package java.net;
+
+/** As java.net.ConnectException: Signals that an error occurred while attempting to connect a socket to a remote address and port (connection refused). */
+public class ConnectException extends SocketException {
+   public ConnectException(String msg) {
+      super(msg);
+   }
+
+   public ConnectException() {
+   }
+}
diff --git a/runtime/src/java/net/FileURLConnection.java b/runtime/src/java/net/FileURLConnection.java
new file mode 100644
index 0000000..3ec9000
--- /dev/null
+++ b/runtime/src/java/net/FileURLConnection.java
@@ -0,0 +1,80 @@
+package java.net;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileNotFoundException;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.List;
+import java.util.Map;
+
+/** A file: URL opened, as the JDK's (the file's length, date and type as headers). */
+final class FileURLConnection extends URLConnection {
+   private File file;
+   private InputStream is;
+
+   FileURLConnection(URL u) {
+      super(u);
+   }
+
+   private File file() {
+      if (file == null) {
+         String p = url.getPath();
+         file = new File(URLDecoderPlain.decode(p));
+      }
+      return file;
+   }
+
+   public void connect() throws IOException {
+      if (!connected) {
+         File f = file();
+         if (f.isDirectory()) {
+            String[] names = f.list();
+            if (names == null)
+               throw new FileNotFoundException(f.getPath() + " exists, but is not accessible");
+            java.util.Arrays.sort(names);
+            StringBuilder sb = new StringBuilder();
+            for (String n : names)
+               sb.append(n).append('\n');
+            is = new java.io.ByteArrayInputStream(sb.toString().getBytes());
+         } else {
+            is = new java.io.BufferedInputStream(new FileInputStream(f));
+         }
+         connected = true;
+      }
+   }
+
+   public String getHeaderField(String name) {
+      if (name == null)
+         return null;
+      File f = file();
+      if (name.equalsIgnoreCase("content-length"))
+         return f.exists() ? String.valueOf(f.length()) : null;
+      if (name.equalsIgnoreCase("last-modified"))
+         return f.exists() ? HttpDates.format(f.lastModified()) : null;
+      if (name.equalsIgnoreCase("content-type")) {
+         if (f.isDirectory())
+            return "text/plain";
+         String t = guessContentTypeFromName(f.getName());
+         return t != null ? t : "content/unknown";
+      }
+      return null;
+   }
+
+   public long getLastModified() {
+      return file().lastModified();
+   }
+
+   public long getContentLengthLong() {
+      return file().exists() ? file().length() : -1;
+   }
+
+   public Map<String, List<String>> getHeaderFields() {
+      return super.getHeaderFields();
+   }
+
+   public InputStream getInputStream() throws IOException {
+      connect();
+      return is;
+   }
+}
diff --git a/runtime/src/java/net/HttpConnection.java b/runtime/src/java/net/HttpConnection.java
new file mode 100644
index 0000000..f1171b2
--- /dev/null
+++ b/runtime/src/java/net/HttpConnection.java
@@ -0,0 +1,391 @@
+package java.net;
+
+import java.io.BufferedInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.FileNotFoundException;
+import java.io.FilterInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * HTTP/1.1 over a Socket, one request per connection: what the JDK's
+ * HttpURLConnection does that the client needs (GET, HEAD, POST, request
+ * headers, redirects, chunked and length-delimited bodies, the JDK's
+ * exceptions for error codes). No proxies, no keep-alive, no https.
+ */
+final class HttpConnection extends HttpURLConnection {
+   private Socket socket;
+   private InputStream body;
+   private InputStream errorBody;
+   /** Header lines as received: keys[0] null with the status line. */
+   private final ArrayList<String> keys = new ArrayList<String>();
+   private final ArrayList<String> values = new ArrayList<String>();
+   private ByteArrayOutputStream posted;
+   private IOException failure;
+   private boolean requested;
+
+   HttpConnection(URL u) {
+      super(u);
+   }
+
+   public void connect() throws IOException {
+      if (connected)
+         return;
+      connected = true;
+   }
+
+   public boolean usingProxy() {
+      return false;
+   }
+
+   public void disconnect() {
+      if (socket != null) {
+         try {
+            socket.close();
+         } catch (IOException e) {
+         }
+      }
+   }
+
+   public OutputStream getOutputStream() throws IOException {
+      if (!doOutput)
+         throw new ProtocolException("cannot write to a URLConnection if doOutput=false - call setDoOutput(true)");
+      if (requested)
+         throw new ProtocolException("Cannot write output after reading input.");
+      if (method.equals("GET"))
+         method = "POST";
+      connect();
+      if (posted == null)
+         posted = new ByteArrayOutputStream();
+      return posted;
+   }
+
+   /** Sends the request and reads the status and headers, following redirects. */
+   private void request() throws IOException {
+      if (requested) {
+         if (failure != null)
+            throw failure;
+         return;
+      }
+      requested = true;
+      connect();
+      try {
+         URL target = url;
+         for (int redirects = 0; ; redirects++) {
+            exchange(target);
+            int code = statusCode();
+            if (instanceFollowRedirects && redirects < 20 && (code == 301 || code == 302 || code == 303 || code == 307)
+                  && (posted == null || code == 303)) {
+               String loc = getHeaderField("Location");
+               if (loc != null) {
+                  URL next = new URL(target, loc);
+                  if (next.getProtocol().equals(target.getProtocol())) {
+                     socket.close();
+                     if (code == 303)
+                        method = "GET";
+                     target = next;
+                     url = next;
+                     continue;
+                  }
+               }
+            }
+            break;
+         }
+      } catch (IOException e) {
+         failure = e;
+         throw e;
+      }
+   }
+
+   private int statusCode() {
+      String status = values.isEmpty() ? null : values.get(0);
+      if (status == null)
+         return -1;
+      String[] p = status.split(" ");
+      try {
+         return p.length > 1 ? Integer.parseInt(p[1]) : -1;
+      } catch (NumberFormatException e) {
+         return -1;
+      }
+   }
+
+   private void exchange(URL target) throws IOException {
+      keys.clear();
+      values.clear();
+      responseCode = -1;
+      responseMessage = null;
+      String host = target.getHost();
+      int port = target.getPort() != -1 ? target.getPort() : 80;
+      if (host == null || host.isEmpty())
+         throw new UnknownHostException("no host in " + target);
+      Socket s = new Socket();
+      s.connect(new InetSocketAddress(host, port), getConnectTimeout());
+      if (getReadTimeout() > 0)
+         s.setSoTimeout(getReadTimeout());
+      socket = s;
+      String file = target.getFile();
+      if (file == null || file.isEmpty())
+         file = "/";
+      StringBuilder req = new StringBuilder();
+      req.append(method).append(' ').append(file).append(" HTTP/1.1\r\n");
+      Map<String, List<String>> props = requestHeaders();
+      if (!has(props, "Host"))
+         req.append("Host: ").append(host).append(target.getPort() != -1 && target.getPort() != 80 ? ":" + target.getPort() : "").append("\r\n");
+      if (!has(props, "User-Agent"))
+         req.append("User-Agent: Java/").append(System.getProperty("java.version")).append("\r\n");
+      if (!has(props, "Accept"))
