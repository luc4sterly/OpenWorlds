index 0000000..5f06fa4
--- /dev/null
+++ b/runtime/res/clearwing/src/Net.cpp
@@ -0,0 +1,331 @@
+// java.net's natives: BSD sockets (IPv4, TCP) and the resolver. Only built when the program uses them.
+#if __has_include("java/net/PlainSocketImpl.h")
+#include "java/net/PlainSocketImpl.h"
+#define HAS_SOCKETS 1
+#endif
+#if __has_include("java/net/Inet4AddressImpl.h")
+#include "java/net/Inet4AddressImpl.h"
+#define HAS_RESOLVER 1
+#endif
+#include "java/lang/String.h"
+
+#if HAS_SOCKETS || HAS_RESOLVER
+#include <cerrno>
+#include <cstring>
+#include <string>
+#include <vector>
+#include <unistd.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <sys/types.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <arpa/inet.h>
+#include <netdb.h>
+#if !defined(__vita__)
+#include <sys/ioctl.h>
+#endif
+
+/// Waits until the descriptor is ready (POLLIN or POLLOUT): 1 ready, 0 timed out, -errno.
+static int waitReady(jcontext ctx, int fd, short events, int timeout) {
+    struct pollfd p{};
+    p.fd = fd;
+    p.events = events;
+    ctx->suspended = true;
+    int r;
+    do {
+        r = poll(&p, 1, timeout > 0 ? timeout : -1);
+    } while (r < 0 && errno == EINTR);
+    int err = errno;
+    ctx->suspended = false;
+    SAFEPOINT();
+    return r < 0 ? -err : r;
+}
+
+static void toAddress(struct sockaddr_in &sa, const jbyte *address, int port) {
+    memset(&sa, 0, sizeof(sa));
+    sa.sin_family = AF_INET;
+    sa.sin_port = htons((uint16_t) port);
+    memcpy(&sa.sin_addr, address, 4);
+}
+#endif
+
+extern "C" {
+
+#if HAS_SOCKETS
+jint SM_java_net_PlainSocketImpl_socket0_R_int(jcontext ctx) {
+    int fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0)
+        return -errno;
+#if defined(SO_NOSIGPIPE)
+    int one = 1;
+    setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof(one));
+#endif
+    return fd;
+}
+
+jint SM_java_net_PlainSocketImpl_connect0_int_Array1_byte_int_int_R_int(jcontext ctx, jint fd, jobject address, jint port, jint timeout) {
+    struct sockaddr_in sa{};
+    toAddress(sa, (jbyte *) ((jarray) NULL_CHECK(address))->data, port);
+    if (timeout <= 0) {
+        ctx->suspended = true;
+        int r;
+        do {
+            r = connect(fd, (struct sockaddr *) &sa, sizeof(sa));
+        } while (r < 0 && errno == EINTR);
+        int err = errno;
+        ctx->suspended = false;
+        SAFEPOINT();
+        return r < 0 ? -err : 0;
+    }
+    // with a timeout: non-blocking connect, then wait for it
+    int flags = fcntl(fd, F_GETFL, 0);
+    fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+    int r = connect(fd, (struct sockaddr *) &sa, sizeof(sa));
+    int result = 0;
+    if (r < 0) {
+        if (errno != EINPROGRESS && errno != EWOULDBLOCK)
+            result = -errno;
+        else {
+            int w = waitReady(ctx, fd, POLLOUT, timeout);
+            if (w == 0)
+                result = -ETIMEDOUT;
+            else if (w < 0)
+                result = w;
+            else {
+                int err = 0;
+                socklen_t len = sizeof(err);
+                getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &len);
+                result = err ? -err : 0;
+            }
+        }
+    }
+    fcntl(fd, F_SETFL, flags);
+    return result;
+}
+
+jint SM_java_net_PlainSocketImpl_read0_int_Array1_byte_int_int_int_R_int(jcontext ctx, jint fd, jobject b, jint off, jint len, jint timeout) {
+    if (timeout > 0) {
+        int w = waitReady(ctx, fd, POLLIN, timeout);
+        if (w == 0)
+            return -ETIMEDOUT;
+        if (w < 0)
+            return w;
+    }
+    auto data = (jbyte *) ((jarray) NULL_CHECK(b))->data;
+    ctx->suspended = true;
+    ssize_t n;
+    do {
+        n = recv(fd, data + off, (size_t) len, 0);
+    } while (n < 0 && errno == EINTR);
+    int err = errno;
+    ctx->suspended = false;
+    SAFEPOINT();
+    return n < 0 ? -err : (jint) n;
+}
+
+jint SM_java_net_PlainSocketImpl_write0_int_Array1_byte_int_int_R_int(jcontext ctx, jint fd, jobject b, jint off, jint len) {
+    auto data = (jbyte *) ((jarray) NULL_CHECK(b))->data;
+    ctx->suspended = true;
+    ssize_t n;
+    do {
+#if defined(MSG_NOSIGNAL)
+        n = send(fd, data + off, (size_t) len, MSG_NOSIGNAL);
+#else
+        n = send(fd, data + off, (size_t) len, 0);
+#endif
+    } while (n < 0 && errno == EINTR);
+    int err = errno;
+    ctx->suspended = false;
+    SAFEPOINT();
+    return n < 0 ? -err : (jint) n;
+}
+
+jint SM_java_net_PlainSocketImpl_available0_int_R_int(jcontext ctx, jint fd) {
+#if defined(__vita__)
+    // no FIONREAD: say whether a read would not block
+    struct pollfd p{};
+    p.fd = fd;
+    p.events = POLLIN;
+    return poll(&p, 1, 0) > 0 ? 1 : 0;
+#else
+    int n = 0;
+    if (ioctl(fd, FIONREAD, &n) < 0)
+        return -errno;
+    return n;
+#endif
+}
+
+void SM_java_net_PlainSocketImpl_close0_int(jcontext ctx, jint fd) {
+    // shutdown wakes a thread blocked reading it, as closing a Java socket does
+    shutdown(fd, SHUT_RDWR);
+    close(fd);
+}
+
+jint SM_java_net_PlainSocketImpl_shutdown0_int_int_R_int(jcontext ctx, jint fd, jint how) {
+    return shutdown(fd, how == 0 ? SHUT_RD : SHUT_WR) < 0 ? -errno : 0;
+}
+
+jint SM_java_net_PlainSocketImpl_bind0_int_Array1_byte_int_R_int(jcontext ctx, jint fd, jobject address, jint port) {
+    struct sockaddr_in sa{};
+    toAddress(sa, (jbyte *) ((jarray) NULL_CHECK(address))->data, port);
+    return bind(fd, (struct sockaddr *) &sa, sizeof(sa)) < 0 ? -errno : 0;
+}
+
+jint SM_java_net_PlainSocketImpl_listen0_int_int_R_int(jcontext ctx, jint fd, jint backlog) {
+    return listen(fd, backlog) < 0 ? -errno : 0;
+}
+
+jint SM_java_net_PlainSocketImpl_accept0_int_int_Array1_byte_Array1_int_R_int(jcontext ctx, jint fd, jint timeout, jobject address, jobject port) {
+    if (timeout > 0) {
+        int w = waitReady(ctx, fd, POLLIN, timeout);
+        if (w == 0)
+            return -ETIMEDOUT;
+        if (w < 0)
+            return w;
+    }
+    struct sockaddr_in sa{};
+    socklen_t len = sizeof(sa);
+    ctx->suspended = true;
+    int s;
+    do {
+        s = accept(fd, (struct sockaddr *) &sa, &len);
+    } while (s < 0 && errno == EINTR);
+    int err = errno;
+    ctx->suspended = false;
+    SAFEPOINT();
+    if (s < 0)
+        return -err;
+    memcpy(((jarray) NULL_CHECK(address))->data, &sa.sin_addr, 4);
+    ((jint *) ((jarray) NULL_CHECK(port))->data)[0] = ntohs(sa.sin_port);
+    return s;
+}
+
+jint SM_java_net_PlainSocketImpl_localPort0_int_R_int(jcontext ctx, jint fd) {
+    struct sockaddr_in sa{};
+    socklen_t len = sizeof(sa);
+    if (getsockname(fd, (struct sockaddr *) &sa, &len) < 0)
+        return -1;
+    return ntohs(sa.sin_port);
+}
+
+void SM_java_net_PlainSocketImpl_localAddress0_int_Array1_byte(jcontext ctx, jint fd, jobject address) {
+    struct sockaddr_in sa{};
+    socklen_t len = sizeof(sa);
+    if (getsockname(fd, (struct sockaddr *) &sa, &len) == 0)
+        memcpy(((jarray) NULL_CHECK(address))->data, &sa.sin_addr, 4);
+}
+
+jint SM_java_net_PlainSocketImpl_setOption0_int_int_int_R_int(jcontext ctx, jint fd, jint option, jint value) {
+    int r;
+    switch (option) {
+        case 1:
+            r = setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &value, sizeof(value));
+            break;
+        case 2:
+            r = setsockopt(fd, SOL_SOCKET, SO_KEEPALIVE, &value, sizeof(value));
+            break;
+        case 3: {
+            struct linger l{};
+            l.l_onoff = value >= 0;
+            l.l_linger = value >= 0 ? value : 0;
+            r = setsockopt(fd, SOL_SOCKET, SO_LINGER, &l, sizeof(l));
+            break;
+        }
+        case 4:
+            r = setsockopt(fd, SOL_SOCKET, SO_RCVBUF, &value, sizeof(value));
+            break;
+        case 5:
+            r = setsockopt(fd, SOL_SOCKET, SO_SNDBUF, &value, sizeof(value));
+            break;
+        case 6:
+            r = setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &value, sizeof(value));
+            break;
+        default:
+            return -EINVAL;
+    }
+    return r < 0 ? -errno : 0;
+}
+
+jint SM_java_net_PlainSocketImpl_errnoKind_int_R_int(jcontext ctx, jint err) {
+    switch (err) {
+        case ECONNREFUSED: return 1;
+        case ETIMEDOUT: return 2;
+        case EHOSTUNREACH:
+        case ENETUNREACH: return 3;
+        case EADDRINUSE: return 4;
+        case EAGAIN:
+#if EWOULDBLOCK != EAGAIN
+        case EWOULDBLOCK:
+#endif
+            return 5;
+        case ECONNRESET:
+        case ECONNABORTED: return 6;
+        case EPIPE: return 7;
+        default: return 0;
+    }
+}
+
+jobject SM_java_net_PlainSocketImpl_errorText_int_R_java_lang_String(jcontext ctx, jint err) {
+    return (jobject) stringFromNative(ctx, strerror(err));
+}
+#endif
+
+#if HAS_RESOLVER
+jobject SM_java_net_Inet4AddressImpl_localHostName0_R_java_lang_String(jcontext ctx) {
+    char name[256]{};
+    if (gethostname(name, sizeof(name) - 1) != 0)
+        return nullptr;
+    return (jobject) stringFromNative(ctx, name);
+}
+
+jobject SM_java_net_Inet4AddressImpl_lookup0_java_lang_String_R_Array2_byte(jcontext ctx, jobject host) {
+    std::string name(stringToNative(ctx, (jstring) NULL_CHECK(host)));
+    struct addrinfo hints{};
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_STREAM;
+    struct addrinfo *result = nullptr;
+    ctx->suspended = true;
+    int r = getaddrinfo(name.c_str(), nullptr, &hints, &result);
+    ctx->suspended = false;
+    SAFEPOINT();
+    if (r != 0 || !result)
+        return nullptr;
+    std::vector<uint32_t> found;
+    for (auto p = result; p; p = p->ai_next) {
+        if (p->ai_family != AF_INET)
+            continue;
+        uint32_t a = ((struct sockaddr_in *) p->ai_addr)->sin_addr.s_addr;
+        bool seen = false;
+        for (auto f : found)
+            seen |= f == a;
+        if (!seen)
+            found.push_back(a);
+    }
+    freeaddrinfo(result);
+    jclass arrayType = getArrayClass(&class_byte, 1);
+    auto array = createArray(ctx, arrayType, (int) found.size());
+    for (int i = 0; i < (int) found.size(); i++) {
+        auto bytes = createArray(ctx, &class_byte, 4);
+        memcpy(bytes->data, &found[i], 4);
+        ((jobject *) array->data)[i] = (jobject) bytes;
+    }
+    return (jobject) array;
+}
+
+jobject SM_java_net_Inet4AddressImpl_hostByAddr0_Array1_byte_R_java_lang_String(jcontext ctx, jobject addr) {
+    struct sockaddr_in sa{};
+    toAddress(sa, (jbyte *) ((jarray) NULL_CHECK(addr))->data, 0);
+    char name[NI_MAXHOST]{};
+    ctx->suspended = true;
+    int r = getnameinfo((struct sockaddr *) &sa, sizeof(sa), name, sizeof(name), nullptr, 0, NI_NAMEREQD);
+    ctx->suspended = false;
+    SAFEPOINT();
+    if (r != 0)
+        return nullptr;
+    return (jobject) stringFromNative(ctx, name);
+}
+#endif
+
+}
