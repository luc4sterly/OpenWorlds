+                  throw new SocketException("Socket closed");
+               int kind = PlainSocketImpl.errnoKind(-n);
+               throw new SocketException(kind == PlainSocketImpl.BROKEN_PIPE ? "Broken pipe"
+                     : kind == PlainSocketImpl.RESET ? "Connection reset by peer" : PlainSocketImpl.errorText(-n));
+            }
+            off += n;
+            len -= n;
+         }
+      }
+
+      public void close() throws IOException {
+         Socket.this.close();
+      }
+   }
+}
