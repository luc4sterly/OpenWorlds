+   static long parse(String s) {
+      if (s == null)
+         return Long.MIN_VALUE;
+      try {
+         String t = s.trim();
+         int comma = t.indexOf(',');
+         if (comma >= 0)
+            t = t.substring(comma + 1).trim();
+         else {
+            // asctime: "Sun Nov  6 08:49:37 1994"
+            String[] p = t.split("\\s+");
+            if (p.length == 5) {
+               int month = month(p[1]);
+               int day = Integer.parseInt(p[2]);
+               int year = Integer.parseInt(p[4]);
+               return toMillis(year, month, day, p[3]);
+            }
+            return Long.MIN_VALUE;
+         }
+         String[] p = t.split("[\\s-]+");
+         // RFC 1123 "06 Nov 1994 08:49:37 GMT", RFC 850 "06-Nov-94 08:49:37 GMT"
+         int day = Integer.parseInt(p[0]);
+         int month = month(p[1]);
+         int year = Integer.parseInt(p[2]);
+         if (p[2].length() <= 2)
+            year += year < 70 ? 2000 : 1900;
+         return toMillis(year, month, day, p[3]);
+      } catch (RuntimeException e) {
+         return Long.MIN_VALUE;
+      }
+   }
+
+   private static int month(String m) {
+      String l = m.toLowerCase();
+      for (int i = 0; i < 12; i++)
+         if (l.startsWith(MONTHS[i]))
+            return i + 1;
+      throw new IllegalArgumentException(m);
+   }
+
+   private static long toMillis(int year, int month, int day, String time) {
+      String[] hms = time.split(":");
+      int h = Integer.parseInt(hms[0]);
+      int mi = Integer.parseInt(hms[1]);
+      int se = hms.length > 2 ? Integer.parseInt(hms[2]) : 0;
+      return (daysFromCivil(year, month, day) * 86400L + h * 3600L + mi * 60L + se) * 1000L;
+   }
+
+   /** Days since 1970-01-01 of a proleptic Gregorian date. */
+   static long daysFromCivil(long y, int m, int d) {
+      y -= m <= 2 ? 1 : 0;
+      long era = (y >= 0 ? y : y - 399) / 400;
+      long yoe = y - era * 400;
+      long doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
+      long doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+      return era * 146097 + doe - 719468;
+   }
+
+   private static final String[] MON = {"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"};
+
+   /** RFC 1123, for If-Modified-Since. */
+   static String format(long millis) {
+      long days = Math.floorDiv(millis, 86400000L);
+      long secs = Math.floorMod(millis, 86400000L) / 1000;
+      long z = days + 719468;
+      long era = (z >= 0 ? z : z - 146096) / 146097;
+      long doe = z - era * 146097;
+      long yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
+      long y = yoe + era * 400;
+      long doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+      long mp = (5 * doy + 2) / 153;
+      long d = doy - (153 * mp + 2) / 5 + 1;
+      long m = mp + (mp < 10 ? 3 : -9);
+      if (m <= 2)
