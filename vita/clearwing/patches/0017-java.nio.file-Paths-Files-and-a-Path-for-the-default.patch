diff --git a/runtime/src/java/nio/file/UnixPath.java b/runtime/src/java/nio/file/UnixPath.java
new file mode 100644
index 0000000..1ca6cb6
--- /dev/null
+++ b/runtime/src/java/nio/file/UnixPath.java
@@ -0,0 +1,177 @@
+package java.nio.file;
+
+import java.io.File;
+import java.io.IOException;
+import java.net.URI;
+import java.util.ArrayList;
+
+/** The runtime's one kind of Path: a file name as java.io.File keeps it (Paths.get, File.toPath). */
+final class UnixPath implements Path {
+   private final String path;
+   private String[] names;
+
+   UnixPath(String path) {
+      this.path = new File(path).getPath();
+   }
+
+   private String[] names() {
+      if (names == null) {
+         ArrayList<String> out = new ArrayList<>();
+         for (String s : path.split("/"))
+            if (!s.isEmpty())
+               out.add(s);
+         names = out.toArray(new String[0]);
+      }
+      return names;
+   }
+
+   public FileSystem getFileSystem() {
+      return null;
+   }
+
+   public boolean isAbsolute() {
+      return new File(path).isAbsolute();
+   }
+
+   public Path getRoot() {
+      return isAbsolute() ? new UnixPath(path.substring(0, path.indexOf('/') + 1)) : null;
+   }
+
+   public Path getFileName() {
+      if (path.isEmpty())
+         return this;
+      String[] n = names();
+      return n.length == 0 ? null : new UnixPath(n[n.length - 1]);
+   }
+
+   public Path getParent() {
+      String p = new File(path).getParent();
+      return p == null ? null : new UnixPath(p);
+   }
+
+   public int getNameCount() {
+      return path.isEmpty() ? 1 : names().length;
+   }
+
+   public Path getName(int index) {
+      String[] n = names();
+      if (index < 0 || index >= n.length)
+         throw new IllegalArgumentException();
+      return new UnixPath(n[index]);
+   }
+
+   public Path subpath(int beginIndex, int endIndex) {
+      String[] n = names();
+      if (beginIndex < 0 || endIndex > n.length || beginIndex >= endIndex)
+         throw new IllegalArgumentException();
+      StringBuilder sb = new StringBuilder();
+      for (int i = beginIndex; i < endIndex; i++) {
+         if (i > beginIndex)
+            sb.append('/');
+         sb.append(n[i]);
+      }
+      return new UnixPath(sb.toString());
+   }
+
+   public boolean startsWith(Path other) {
+      return path.equals(other.toString()) || path.startsWith(other.toString().endsWith("/") ? other.toString() : other + "/");
+   }
+
+   public boolean startsWith(String other) {
+      return startsWith(new UnixPath(other));
+   }
+
+   public boolean endsWith(Path other) {
+      String o = other.toString();
+      return path.equals(o) || (!other.isAbsolute() && path.endsWith("/" + o));
+   }
+
+   public boolean endsWith(String other) {
+      return endsWith(new UnixPath(other));
+   }
+
+   public Path normalize() {
+      ArrayList<String> out = new ArrayList<>();
+      for (String s : names()) {
+         if (s.equals("."))
+            continue;
+         if (s.equals("..") && !out.isEmpty() && !out.get(out.size() - 1).equals("..")) {
+            out.remove(out.size() - 1);
+            continue;
+         }
+         out.add(s);
+      }
+      StringBuilder sb = new StringBuilder(isAbsolute() ? path.substring(0, path.indexOf('/') + 1) : "");
+      for (int i = 0; i < out.size(); i++) {
+         if (i > 0)
+            sb.append('/');
+         sb.append(out.get(i));
+      }
+      return new UnixPath(sb.toString());
+   }
+
+   public Path resolve(Path other) {
+      if (other.isAbsolute())
+         return other;
+      if (other.toString().isEmpty())
+         return this;
+      return new UnixPath(new File(path, other.toString()).getPath());
+   }
+
+   public Path resolve(String other) {
+      return resolve(new UnixPath(other));
+   }
+
+   public Path resolveSibling(String other) {
+      return resolveSibling(new UnixPath(other));
+   }
+
+   public Path relativize(Path other) {
+      String o = other.toString();
+      if (o.startsWith(path + "/"))
+         return new UnixPath(o.substring(path.length() + 1));
+      if (o.equals(path))
+         return new UnixPath("");
+      throw new IllegalArgumentException("'other' is not under this path");
+   }
+
+   public URI toUri() {
+      return new File(path).toURI();
+   }
+
+   public Path toAbsolutePath() {
+      return new UnixPath(new File(path).getAbsolutePath());
+   }
+
+   public Path toRealPath(LinkOption... options) throws IOException {
+      return new UnixPath(new File(path).getCanonicalPath());
+   }
+
+   public File toFile() {
+      return new File(path);
+   }
+
+   public WatchKey register(WatchService watcher, WatchEvent.Kind<?>[] events, WatchEvent.Modifier... modifiers) throws IOException {
+      throw new UnsupportedOperationException();
+   }
+
+   public WatchKey register(WatchService watcher, WatchEvent.Kind<?>... events) throws IOException {
+      throw new UnsupportedOperationException();
+   }
+
+   public int compareTo(Path other) {
+      return path.compareTo(other.toString());
+   }
+
+   public boolean equals(Object o) {
+      return o instanceof UnixPath && ((UnixPath) o).path.equals(path);
+   }
+
+   public int hashCode() {
+      return path.hashCode();
+   }
+
+   public String toString() {
+      return path;
+   }
+}
