diff --git a/runtime/src/java/nio/file/FileSystemException.java b/runtime/src/java/nio/file/FileSystemException.java
new file mode 100644
index 0000000..441cbfb
--- /dev/null
+++ b/runtime/src/java/nio/file/FileSystemException.java
@@ -0,0 +1,51 @@
+package java.nio.file;
+
+/** A file system operation failed on a file, as java.nio.file.FileSystemException. */
+public class FileSystemException extends java.io.IOException {
+   private final String file;
+   private final String other;
+   private final String reason;
+
+   public FileSystemException(String file) {
+      super((String) null);
+      this.file = file;
+      this.other = null;
+      this.reason = null;
+   }
+
+   public FileSystemException(String file, String other, String reason) {
+      super(reason);
+      this.file = file;
+      this.other = other;
+      this.reason = reason;
+   }
+
+   public String getFile() {
+      return file;
+   }
+
+   public String getOtherFile() {
+      return other;
+   }
+
+   public String getReason() {
+      return reason;
+   }
+
+   public String getMessage() {
+      if (file == null && other == null)
+         return getReason();
+      StringBuilder sb = new StringBuilder();
+      if (file != null)
+         sb.append(file);
+      if (other != null) {
+         sb.append(" -> ");
+         sb.append(other);
+      }
+      if (getReason() != null) {
+         sb.append(": ");
+         sb.append(getReason());
+      }
+      return sb.toString();
+   }
+}
