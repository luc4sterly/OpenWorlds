diff --git a/runtime/src/java/nio/file/Files.java b/runtime/src/java/nio/file/Files.java
new file mode 100644
index 0000000..cf89986
--- /dev/null
+++ b/runtime/src/java/nio/file/Files.java
@@ -0,0 +1,190 @@
+package java.nio.file;
+
+import java.io.BufferedReader;
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.io.OutputStream;
+import java.nio.charset.Charset;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+
+/** What java.nio.file.Files does with whole files, over java.io (the default file system only). */
+public final class Files {
+   private Files() {
+   }
+
+   private static File file(Path path) {
+      return new File(path.toString());
+   }
+
+   public static byte[] readAllBytes(Path path) throws IOException {
+      File f = file(path);
+      if (!f.exists())
+         throw new NoSuchFileException(path.toString());
+      try (InputStream in = new FileInputStream(f)) {
+         long size = f.length();
+         if (size > Integer.MAX_VALUE - 8)
+            throw new OutOfMemoryError("Required array size too large");
+         ByteArrayOutputStream out = new ByteArrayOutputStream(size > 0 ? (int) size : 8192);
+         byte[] buf = new byte[8192];
+         int n;
+         while ((n = in.read(buf)) > 0)
+            out.write(buf, 0, n);
+         return out.toByteArray();
+      }
+   }
+
+   public static List<String> readAllLines(Path path, Charset cs) throws IOException {
+      File f = file(path);
+      if (!f.exists())
+         throw new NoSuchFileException(path.toString());
+      try (BufferedReader r = new BufferedReader(new InputStreamReader(new FileInputStream(f), cs))) {
+         List<String> result = new ArrayList<>();
+         for (String line = r.readLine(); line != null; line = r.readLine())
+            result.add(line);
+         return result;
+      }
+   }
+
+   public static List<String> readAllLines(Path path) throws IOException {
+      return readAllLines(path, StandardCharsets.UTF_8);
+   }
+
+   private static OutputStream open(Path path, OpenOption... options) throws IOException {
+      boolean append = false;
+      boolean createNew = false;
+      boolean create = options.length == 0;
+      for (OpenOption o : options) {
+         if (o == StandardOpenOption.APPEND)
+            append = true;
+         else if (o == StandardOpenOption.CREATE_NEW)
+            createNew = true;
+         else if (o == StandardOpenOption.CREATE)
+            create = true;
+      }
+      File f = file(path);
+      if (createNew && f.exists())
+         throw new FileAlreadyExistsException(path.toString());
+      if (!create && !createNew && !f.exists())
+         throw new NoSuchFileException(path.toString());
+      return new FileOutputStream(f, append);
+   }
+
+   public static Path write(Path path, byte[] bytes, OpenOption... options) throws IOException {
+      try (OutputStream out = open(path, options)) {
+         out.write(bytes, 0, bytes.length);
+      }
+      return path;
+   }
+
+   public static Path write(Path path, Iterable<? extends CharSequence> lines, Charset cs, OpenOption... options) throws IOException {
+      StringBuilder sb = new StringBuilder();
+      for (CharSequence line : lines)
+         sb.append(line).append(System.lineSeparator());
+      return write(path, sb.toString().getBytes(cs), options);
+   }
+
+   public static Path write(Path path, Iterable<? extends CharSequence> lines, OpenOption... options) throws IOException {
+      return write(path, lines, StandardCharsets.UTF_8, options);
+   }
+
+   public static boolean exists(Path path, LinkOption... options) {
+      return file(path).exists();
+   }
+
+   public static boolean notExists(Path path, LinkOption... options) {
+      return !file(path).exists();
+   }
+
+   public static boolean isDirectory(Path path, LinkOption... options) {
+      return file(path).isDirectory();
+   }
+
+   public static boolean isRegularFile(Path path, LinkOption... options) {
+      return file(path).isFile();
+   }
+
+   public static boolean isReadable(Path path) {
+      return file(path).canRead();
+   }
+
+   public static boolean isWritable(Path path) {
+      return file(path).canWrite();
+   }
+
+   public static long size(Path path) throws IOException {
+      File f = file(path);
+      if (!f.exists())
+         throw new NoSuchFileException(path.toString());
+      return f.length();
+   }
+
+   public static void delete(Path path) throws IOException {
+      File f = file(path);
+      if (!f.exists())
+         throw new NoSuchFileException(path.toString());
+      if (!f.delete())
+         throw new FileSystemException(path.toString(), null, f.isDirectory() ? "Directory not empty" : "Cannot delete");
+   }
+
+   public static boolean deleteIfExists(Path path) throws IOException {
+      File f = file(path);
+      if (!f.exists())
+         return false;
+      delete(path);
+      return true;
+   }
+
+   public static Path createDirectory(Path dir, java.nio.file.attribute.FileAttribute<?>... attrs) throws IOException {
+      File f = file(dir);
+      if (f.exists())
+         throw new FileAlreadyExistsException(dir.toString());
+      if (!f.mkdir())
+         throw new FileSystemException(dir.toString(), null, "Cannot create directory");
+      return dir;
+   }
+
+   public static Path createDirectories(Path dir, java.nio.file.attribute.FileAttribute<?>... attrs) throws IOException {
+      File f = file(dir);
+      if (f.isDirectory())
+         return dir;
+      if (!f.mkdirs() && !f.isDirectory())
+         throw new FileSystemException(dir.toString(), null, "Cannot create directories");
+      return dir;
+   }
+
+   public static Path move(Path source, Path target, CopyOption... options) throws IOException {
+      if (!file(source).renameTo(file(target)))
+         throw new FileSystemException(source.toString(), target.toString(), "Cannot move");
+      return target;
+   }
+
+   /** "unix:dev" (the device of the file, as stat's st_dev); other attributes are not kept here. */
+   public static Object getAttribute(Path path, String attribute, LinkOption... options) throws IOException {
+      int colon = attribute.indexOf(':');
+      String view = colon < 0 ? "basic" : attribute.substring(0, colon);
+      String name = colon < 0 ? attribute : attribute.substring(colon + 1);
+      File f = file(path);
+      if (!f.exists())
+         throw new NoSuchFileException(path.toString());
+      if (view.equals("unix") && name.equals("dev"))
+         return Long.valueOf(device0(f.getAbsolutePath()));
+      if (view.equals("basic") && name.equals("size"))
+         return Long.valueOf(f.length());
+      if (view.equals("basic") && (name.equals("isDirectory")))
+         return Boolean.valueOf(f.isDirectory());
+      if (view.equals("basic") && (name.equals("isRegularFile")))
+         return Boolean.valueOf(f.isFile());
+      if (!view.equals("unix") && !view.equals("basic"))
+         throw new UnsupportedOperationException("View '" + view + "' not available");
+      throw new IllegalArgumentException("'" + name + "' not recognized");
+   }
+
+   private static native long device0(String path);
+}
