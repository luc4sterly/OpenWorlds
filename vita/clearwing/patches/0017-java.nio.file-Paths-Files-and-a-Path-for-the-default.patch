diff --git a/runtime/src/java/nio/file/Paths.java b/runtime/src/java/nio/file/Paths.java
new file mode 100644
index 0000000..dd0403e
--- /dev/null
+++ b/runtime/src/java/nio/file/Paths.java
@@ -0,0 +1,27 @@
+package java.nio.file;
+
+import java.net.URI;
+
+/** Paths of the default file system, as java.nio.file.Paths. */
+public final class Paths {
+   private Paths() {
+   }
+
+   public static Path get(String first, String... more) {
+      StringBuilder sb = new StringBuilder(first);
+      for (String m : more) {
+         if (m.isEmpty())
+            continue;
+         if (sb.length() > 0)
+            sb.append('/');
+         sb.append(m);
+      }
+      return new UnixPath(sb.toString());
+   }
+
+   public static Path get(URI uri) {
+      if (!"file".equalsIgnoreCase(uri.getScheme()))
+         throw new FileSystemNotFoundException("Provider \"" + uri.getScheme() + "\" not installed");
+      return new UnixPath(uri.getPath());
+   }
+}
