From 9412833fcab95d2bdd0907c06d39296e503393ca Mon Sep 17 00:00:00 2001
From: OpenWorlds <openworlds@localhost>
Date: Thu, 8 Oct 2026 16:35:07 +0000
Subject: [PATCH] String literals and native strings carry any Java string

Literals were UTF-8 with universal character names: a control character
(\u0001) or a lone surrogate failed to transpile or to compile, and a
following hex digit could join a \x escape. Now every byte that is not
printable ASCII is a three-digit octal escape and a lone surrogate is
encoded on its own. Strings made from native text (literals, file names,
the command line, the environment) are decoded without failing: U+FFFD
for malformed bytes (std::codecvt threw).
---
 runtime/res/clearwing/src/Clearwing.cpp       | 49 ++++++++++++++++++-
 .../com/thelogicmaster/clearwing/Utils.java   | 44 ++++++++++++-----
 2 files changed, 80 insertions(+), 13 deletions(-)

diff --git a/runtime/res/clearwing/src/Clearwing.cpp b/runtime/res/clearwing/src/Clearwing.cpp
index 332e753..578f17e 100644
--- a/runtime/res/clearwing/src/Clearwing.cpp
+++ b/runtime/res/clearwing/src/Clearwing.cpp
@@ -302,8 +302,55 @@ jint longCompare(jlong value1, jlong value2) {
     return 0;
 }
 
+/// UTF-8 to UTF-16 that never fails: a surrogate encoded on its own (as string literals carry lone
+/// surrogates) gives that char, anything malformed gives U+FFFD per byte (names from the system may not be UTF-8).
+static std::u16string decodeNative(const char *string, int length) {
+    std::u16string out;
+    out.reserve(length);
+    auto b = (const unsigned char *) string;
+    int i = 0;
+    while (i < length) {
+        unsigned c = b[i];
+        if (c < 0x80) {
+            out.push_back((char16_t) c);
+            i++;
+            continue;
+        }
+        int need = c >= 0xC2 && c <= 0xDF ? 1 : c >= 0xE0 && c <= 0xEF ? 2 : c >= 0xF0 && c <= 0xF4 ? 3 : -1;
+        if (need < 0 || i + need >= length) {
+            out.push_back(u'\uFFFD');
+            i++;
+            continue;
+        }
+        unsigned cp = c & (0x3F >> need);
+        bool ok = true;
+        for (int k = 1; k <= need; k++) {
+            unsigned d = b[i + k];
+            if ((d & 0xC0) != 0x80) {
+                ok = false;
+                break;
+            }
+            cp = (cp << 6) | (d & 0x3F);
+        }
+        unsigned min = need == 1 ? 0x80 : need == 2 ? 0x800 : 0x10000;
+        if (!ok || cp < min || cp > 0x10FFFF) {
+            out.push_back(u'\uFFFD');
+            i++;
+            continue;
+        }
+        if (cp >= 0x10000) {
+            cp -= 0x10000;
+            out.push_back((char16_t) (0xD800 | (cp >> 10)));
+            out.push_back((char16_t) (0xDC00 | (cp & 0x3FF)));
+        } else
+            out.push_back((char16_t) cp);
+        i += need + 1;
+    }
+    return out;
+}
+
 static jstring createString(jcontext ctx, const char *string, int length, bool protect) {
-    auto encoded = std::wstring_convert<std::codecvt_utf8_utf16<char16_t>, char16_t>{}.from_bytes(string, string + length);
+    auto encoded = decodeNative(string, length);
     int encodedLength = (int)encoded.length();
     auto inst = (jstring) gcAllocProtected(ctx, &class_java_lang_String); // This leaks if createArray throws an exception
     inst->F_value = (intptr_t) createArray(ctx, &class_char, encodedLength);
diff --git a/transpiler/src/com/thelogicmaster/clearwing/Utils.java b/transpiler/src/com/thelogicmaster/clearwing/Utils.java
index 601cc92..a4ce516 100644
--- a/transpiler/src/com/thelogicmaster/clearwing/Utils.java
+++ b/transpiler/src/com/thelogicmaster/clearwing/Utils.java
@@ -102,26 +102,46 @@ public class Utils {
 	public static String encodeStringLiteral(String string) {
 		if (string == null)
 			string = "";
-		string = string.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n")
-				.replace("\r", "\\r").replace("\t", "\\t");
+		// UTF-8, a lone surrogate encoded on its own (the runtime decodes it back), every byte that is
+		// not printable ASCII as a three-digit octal escape (valid for any value, never longer than it seems)
 		StringBuilder builder = new StringBuilder();
 		builder.append("u8\"");
-		char[] chars = string.toCharArray();
-		for (int i = 0; i < chars.length; i++) {
-			char c = chars[i];
-			if (c >= 32 && c <= 127)
-				builder.append(c);
-			else if (Character.isHighSurrogate(c)) {
-				byte[] bytes = string.substring(i, i + 2).getBytes(StandardCharsets.UTF_8);
-				builder.append(String.format("\\x%02x\\x%02x\\x%02x\\x%02x", bytes[0], bytes[1], bytes[2], bytes[3]));
+		int n = string.length();
+		for (int i = 0; i < n; i++) {
+			char c = string.charAt(i);
+			int cp = c;
+			if (Character.isHighSurrogate(c) && i + 1 < n && Character.isLowSurrogate(string.charAt(i + 1))) {
+				cp = Character.toCodePoint(c, string.charAt(i + 1));
 				i++;
-			} else
-				builder.append("\\u").append(String.format("%04x", (int)c));
+			}
+			if (cp >= 32 && cp < 127 && cp != '\\' && cp != '"' && cp != '?') {
+				builder.append((char) cp);
+				continue;
+			}
+			if (cp < 0x80)
+				octal(builder, cp);
+			else if (cp < 0x800) {
+				octal(builder, 0xC0 | (cp >> 6));
+				octal(builder, 0x80 | (cp & 0x3F));
+			} else if (cp < 0x10000) {
+				octal(builder, 0xE0 | (cp >> 12));
+				octal(builder, 0x80 | ((cp >> 6) & 0x3F));
+				octal(builder, 0x80 | (cp & 0x3F));
+			} else {
+				octal(builder, 0xF0 | (cp >> 18));
+				octal(builder, 0x80 | ((cp >> 12) & 0x3F));
+				octal(builder, 0x80 | ((cp >> 6) & 0x3F));
+				octal(builder, 0x80 | (cp & 0x3F));
+			}
 		}
 		builder.append("\"_j");
 		return builder.toString();
 	}
 
+	private static void octal(StringBuilder builder, int b) {
+		builder.append('\\').append((char) ('0' + ((b >> 6) & 7))).append((char) ('0' + ((b >> 3) & 7))).append((char) ('0' + (b & 7)));
+	}
+
 	/**
 	 * Get a value representation of a Number, String, or Type
 	 */
