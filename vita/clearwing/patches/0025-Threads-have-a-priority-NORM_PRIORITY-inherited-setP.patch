From ee8c8f01989b1cae4405503c22a5492f4decb0f8 Mon Sep 17 00:00:00 2001
From: OpenWorlds <openworlds@localhost>
Date: Thu, 8 Oct 2026 16:45:41 +0000
Subject: [PATCH] Threads have a priority (NORM_PRIORITY, inherited,
 setPriority); the main thread is "main"

---
 runtime/res/clearwing/src/Clearwing.cpp | 3 ++-
 runtime/src/java/lang/Thread.java       | 7 ++++++-
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/runtime/res/clearwing/src/Clearwing.cpp b/runtime/res/clearwing/src/Clearwing.cpp
index 578f17e..e52dab0 100644
--- a/runtime/res/clearwing/src/Clearwing.cpp
+++ b/runtime/res/clearwing/src/Clearwing.cpp
@@ -131,7 +131,8 @@ void runVM(main_ptr entrypoint) {
     thread->F_nativeContext = (intptr_t) mainContext;
     mainContext->thread = thread;
     thread->F_entrypoint = (intptr_t) entrypoint;
-    thread->F_name = (intptr_t) stringFromNative(mainContext, "Main");
+    thread->F_name = (intptr_t) stringFromNative(mainContext, "main");
+    thread->F_priority = 5; // Thread.NORM_PRIORITY (no constructor ran)
     threadEntrypoint(mainContext, thread);
     waitForNonDaemonThreads(mainContext);
 
diff --git a/runtime/src/java/lang/Thread.java b/runtime/src/java/lang/Thread.java
index d1cf389..d8b84f2 100644
--- a/runtime/src/java/lang/Thread.java
+++ b/runtime/src/java/lang/Thread.java
@@ -62,6 +62,7 @@ public class Thread implements java.lang.Runnable{
     private volatile boolean started;
     private long nativeContext;
     private volatile boolean daemon;
+    private volatile int priority = NORM_PRIORITY;
     private static int threadInitNumber;
     private static ThreadGroup group;
 
@@ -108,6 +109,7 @@ public class Thread implements java.lang.Runnable{
          // as on a JVM: a new thread is a daemon if the thread creating it is
          Thread parent = currentThread();
          this.daemon = parent != null && parent.daemon;
+         this.priority = parent != null ? parent.priority : NORM_PRIORITY;
     }
 
     /**
@@ -149,7 +151,7 @@ public class Thread implements java.lang.Runnable{
      * Returns this thread's priority.
      */
     public final int getPriority(){
-        return 0;
+        return priority;
     }
 
     /**
@@ -230,6 +232,9 @@ public class Thread implements java.lang.Runnable{
      * Changes the priority of this thread.
      */
     public final void setPriority(int newPriority){
+        if (newPriority > MAX_PRIORITY || newPriority < MIN_PRIORITY)
+            throw new IllegalArgumentException();
+        priority = newPriority;
     }
 
     /**
-- 
