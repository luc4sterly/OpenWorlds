+         if (fd >= 0 && !lock0(fd, shared)) {
+            return null;
+         }
+         return new FileLock(this, position, size, shared);
+      }
+
+      void release(FileLock lock) throws IOException {
+         if (fd >= 0) {
+            unlock0(fd);
+         }
+      }
+   }
