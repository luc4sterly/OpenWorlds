+package java.nio.channels;
+
+import java.io.IOException;
+
+/** A lock on a file, as java.nio.channels.FileLock. */
+public class FileLock implements AutoCloseable {
+   private final FileChannel channel;
+   private final long position;
+   private final long size;
+   private final boolean shared;
+   private boolean valid = true;
+
+   protected FileLock(FileChannel channel, long position, long size, boolean shared) {
+      this.channel = channel;
+      this.position = position;
+      this.size = size;
+      this.shared = shared;
+   }
+
+   public final FileChannel channel() {
+      return channel;
+   }
+
+   public Channel acquiredBy() {
+      return null;
+   }
+
+   public final long position() {
+      return position;
+   }
+
+   public final long size() {
+      return size;
+   }
+
+   public final boolean isShared() {
+      return shared;
+   }
+
+   public final boolean overlaps(long position, long size) {
+      return position + size > this.position && this.position + this.size > position;
+   }
+
+   public synchronized boolean isValid() {
+      return valid && channel.isOpen();
+   }
+
+   public synchronized void release() throws IOException {
+      if (valid) {
+         valid = false;
+         channel.release(this);
+      }
+   }
+
+   public final void close() throws IOException {
+      release();
+   }
+
+   public final String toString() {
+      return getClass().getName() + "[" + position + ":" + size + " " + (shared ? "shared" : "exclusive") + " " + (isValid() ? "valid" : "invalid") + "]";
+   }
+}
