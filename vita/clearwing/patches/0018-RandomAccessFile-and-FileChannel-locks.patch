diff --git a/runtime/res/clearwing/src/RandomAccessFile.cpp b/runtime/res/clearwing/src/RandomAccessFile.cpp
new file mode 100644
index 0000000..883bfaf
--- /dev/null
+++ b/runtime/res/clearwing/src/RandomAccessFile.cpp
@@ -0,0 +1,102 @@
+#include "java/io/RandomAccessFile.h"
+#include "java/nio/channels/FileChannel.h"
+#include "java/lang/String.h"
+
+#include <cerrno>
+#include <cstdio>
+#include <sys/types.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#if !defined(__vita__)
+#include <sys/file.h>
+#endif
+
+// RandomAccessFile on C stdio; reads and writes let the collector run meanwhile.
+
+static FILE *fileOf(jlong handle) {
+    return (FILE *) (intptr_t) handle;
+}
+
+extern "C" {
+
+jlong SM_java_io_RandomAccessFile_open0_java_lang_String_boolean_R_long(jcontext ctx, jobject path, jbool rw) {
+    auto p = stringToNative(ctx, (jstring) NULL_CHECK(path));
+    FILE *f = fopen(p, rw ? "r+b" : "rb");
+    if (!f && rw && errno == ENOENT)
+        f = fopen(p, "w+b");
+    return (jlong) (intptr_t) f;
+}
+
+jint SM_java_io_RandomAccessFile_read0_long_Array1_byte_int_int_R_int(jcontext ctx, jlong handle, jobject b, jint off, jint len) {
+    auto data = (jbyte *) ((jarray) NULL_CHECK(b))->data;
+    FILE *f = fileOf(handle);
+    ctx->suspended = true;
+    size_t n = fread(data + off, 1, (size_t) len, f);
+    bool failed = n == 0 && ferror(f);
+    if (failed)
+        clearerr(f);
+    ctx->suspended = false;
+    SAFEPOINT();
+    if (failed)
+        throwIOException(ctx, "Read error");
+    return (jint) n;
+}
+
+jint SM_java_io_RandomAccessFile_write0_long_Array1_byte_int_int_R_int(jcontext ctx, jlong handle, jobject b, jint off, jint len) {
+    auto data = (jbyte *) ((jarray) NULL_CHECK(b))->data;
+    FILE *f = fileOf(handle);
+    ctx->suspended = true;
+    size_t n = fwrite(data + off, 1, (size_t) len, f);
+    fflush(f);
+    ctx->suspended = false;
+    SAFEPOINT();
+    return (jint) n;
+}
+
+jbool SM_java_io_RandomAccessFile_seek0_long_long_R_boolean(jcontext ctx, jlong handle, jlong pos) {
+    return fseeko(fileOf(handle), (off_t) pos, SEEK_SET) == 0;
+}
+
+jlong SM_java_io_RandomAccessFile_tell0_long_R_long(jcontext ctx, jlong handle) {
+    return (jlong) ftello(fileOf(handle));
+}
+
+jlong SM_java_io_RandomAccessFile_length0_long_R_long(jcontext ctx, jlong handle) {
+    FILE *f = fileOf(handle);
+    fflush(f);
+    struct stat s{};
+    if (fstat(fileno(f), &s) != 0)
+        return 0;
+    return (jlong) s.st_size;
+}
+
+jbool SM_java_io_RandomAccessFile_setLength0_long_long_R_boolean(jcontext ctx, jlong handle, jlong length) {
+    FILE *f = fileOf(handle);
+    fflush(f);
+    return ftruncate(fileno(f), (off_t) length) == 0;
+}
+
+jint SM_java_io_RandomAccessFile_fd0_long_R_int(jcontext ctx, jlong handle) {
+    return handle ? fileno(fileOf(handle)) : -1;
+}
+
+void SM_java_io_RandomAccessFile_close0_long(jcontext ctx, jlong handle) {
+    if (handle)
+        fclose(fileOf(handle));
+}
+
+jbool SM_java_nio_channels_FileChannel_lock0_int_boolean_R_boolean(jcontext ctx, jint fd, jbool shared) {
+#if defined(__vita__)
+    return true;
+#else
+    return flock(fd, (shared ? LOCK_SH : LOCK_EX) | LOCK_NB) == 0;
+#endif
+}
+
+void SM_java_nio_channels_FileChannel_unlock0_int(jcontext ctx, jint fd) {
+#if !defined(__vita__)
+    flock(fd, LOCK_UN);
+#endif
+}
+
+}
diff --git a/runtime/src/java/io/ModifiedUtf8.java b/runtime/src/java/io/ModifiedUtf8.java
new file mode 100644
index 0000000..de4c961
--- /dev/null
+++ b/runtime/src/java/io/ModifiedUtf8.java
@@ -0,0 +1,92 @@
+package java.io;
+
+/** The modified UTF-8 of DataInput.readUTF and DataOutput.writeUTF. */
+final class ModifiedUtf8 {
+   private ModifiedUtf8() {
+   }
+
+   static String decode(byte[] b, int len) throws UTFDataFormatException {
+      char[] out = new char[len];
+      int count = 0;
+      int n = 0;
+      while (count < len) {
+         int c = b[count] & 0xFF;
+         switch (c >> 4) {
+            case 0:
+            case 1:
+            case 2:
+            case 3:
+            case 4:
+            case 5:
+            case 6:
+            case 7:
+               count++;
+               out[n++] = (char) c;
+               break;
+            case 12:
+            case 13: {
+               count += 2;
+               if (count > len) {
+                  throw new UTFDataFormatException("malformed input: partial character at end");
+               }
+               int c2 = b[count - 1];
+               if ((c2 & 0xC0) != 0x80) {
+                  throw new UTFDataFormatException("malformed input around byte " + count);
+               }
+               out[n++] = (char) (((c & 0x1F) << 6) | (c2 & 0x3F));
+               break;
+            }
+            case 14: {
+               count += 3;
+               if (count > len) {
+                  throw new UTFDataFormatException("malformed input: partial character at end");
+               }
+               int c2 = b[count - 2];
+               int c3 = b[count - 1];
+               if (((c2 & 0xC0) != 0x80) || ((c3 & 0xC0) != 0x80)) {
+                  throw new UTFDataFormatException("malformed input around byte " + (count - 1));
+               }
+               out[n++] = (char) (((c & 0x0F) << 12) | ((c2 & 0x3F) << 6) | (c3 & 0x3F));
+               break;
+            }
+            default:
+               throw new UTFDataFormatException("malformed input around byte " + count);
+         }
+      }
+      return new String(out, 0, n);
+   }
+
+   static byte[] encode(String str) throws UTFDataFormatException {
+      int strlen = str.length();
+      int utflen = 0;
+      for (int i = 0; i < strlen; i++) {
+         int c = str.charAt(i);
+         if ((c >= 0x0001) && (c <= 0x007F)) {
+            utflen++;
+         } else if (c > 0x07FF) {
+            utflen += 3;
+         } else {
+            utflen += 2;
+         }
+      }
+      if (utflen > 65535) {
+         throw new UTFDataFormatException("encoded string too long: " + utflen + " bytes");
+      }
+      byte[] b = new byte[utflen];
+      int count = 0;
+      for (int i = 0; i < strlen; i++) {
+         int c = str.charAt(i);
+         if ((c >= 0x0001) && (c <= 0x007F)) {
+            b[count++] = (byte) c;
+         } else if (c > 0x07FF) {
+            b[count++] = (byte) (0xE0 | ((c >> 12) & 0x0F));
+            b[count++] = (byte) (0x80 | ((c >> 6) & 0x3F));
+            b[count++] = (byte) (0x80 | (c & 0x3F));
+         } else {
+            b[count++] = (byte) (0xC0 | ((c >> 6) & 0x1F));
+            b[count++] = (byte) (0x80 | (c & 0x3F));
+         }
+      }
+      return b;
+   }
+}
