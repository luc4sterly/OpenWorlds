+package java.nio.charset;
+
+import java.io.UnsupportedEncodingException;
+
+/**
+ * The character encodings of the runtime, as the JDK's decoders and encoders
+ * behave by default: malformed or unmappable input becomes U+FFFD when
+ * decoding and '?' when encoding, never an exception. UTF-8, ISO-8859-1,
+ * US-ASCII, windows-1252 and the UTF-16 forms, by their JDK names and
+ * aliases. Internal: used by String, InputStreamReader, OutputStreamWriter
+ * and Charset.
+ */
+public final class Coding {
+   public static final int UTF8 = 0;
+   public static final int LATIN1 = 1;
+   public static final int ASCII = 2;
+   public static final int CP1252 = 3;
+   public static final int UTF16 = 4;
+   public static final int UTF16BE = 5;
+   public static final int UTF16LE = 6;
+
+   private static final String[] CANONICAL = {"UTF-8", "ISO-8859-1", "US-ASCII", "windows-1252", "UTF-16", "UTF-16BE", "UTF-16LE"};
+   /** The names InputStreamReader.getEncoding gives (the JDK's historical names). */
+   private static final String[] HISTORICAL = {"UTF8", "ISO8859_1", "ASCII", "Cp1252", "UTF-16", "UnicodeBigUnmarked", "UnicodeLittleUnmarked"};
+
+   private static final String[][] ALIASES = {
+         {"utf-8", "utf8", "unicode-1-1-utf-8"},
+         {"iso-8859-1", "iso8859_1", "iso8859-1", "8859_1", "iso_8859_1", "iso_8859-1", "iso_8859-1:1987", "iso-ir-100", "latin1", "l1",
+               "ibm819", "ibm-819", "cp819", "819", "csisolatin1"},
+         {"us-ascii", "ascii", "us", "iso646-us", "iso-ir-6", "cp367", "ibm367", "ascii7", "646", "csascii", "ansi_x3.4-1968",
+               "ansi_x3.4-1986", "iso_646.irv:1991", "default"},
+         {"windows-1252", "cp1252", "cp5348"},
+         {"utf-16", "utf_16", "utf16", "unicode", "unicodebig"},
+         {"utf-16be", "utf_16be", "iso-10646-ucs-2", "x-utf-16be", "unicodebigunmarked"},
+         {"utf-16le", "utf_16le", "x-utf-16le", "unicodelittleunmarked"}};
+
+   /** windows-1252's 0x80..0x9F; 0xFFFD for the five bytes it does not define. */
+   private static final char[] CP1252_HIGH = {
+         '€', '�', '‚', 'ƒ', '„', '…', '†', '‡',
+         'ˆ', '‰', 'Š', '‹', 'Œ', '�', 'Ž', '�',
+         '�', '‘', '’', '“', '”', '•', '–', '—',
+         '˜', '™', 'š', '›', 'œ', '�', 'ž', 'Ÿ'};
+
+   private Coding() {
+   }
+
+   /** The encoding of that name, or -1. */
+   public static int find(String name) {
+      if (name == null) {
+         return -1;
+      }
+      String n = name.toLowerCase();
+      for (int i = 0; i < ALIASES.length; i++) {
+         for (String a : ALIASES[i]) {
+            if (a.equals(n)) {
+               return i;
+            }
+         }
+      }
+      return -1;
+   }
+
+   public static int lookup(String name) throws UnsupportedEncodingException {
+      if (name == null) {
+         throw new NullPointerException("charsetName");
+      }
+      int cs = find(name);
+      if (cs < 0) {
+         throw new UnsupportedEncodingException(name);
+      }
+      return cs;
+   }
+
+   public static String canonicalName(int cs) {
+      return CANONICAL[cs];
+   }
+
+   public static String historicalName(int cs) {
+      return HISTORICAL[cs];
+   }
+
+   public static String[] aliases(int cs) {
+      return ALIASES[cs].clone();
+   }
+
+   // ------------------------------------------------------------------ whole arrays
+
+   public static char[] decode(int cs, byte[] b, int off, int len) {
+      if (off < 0 || len < 0 || off > b.length - len) {
+         throw new StringIndexOutOfBoundsException("offset " + off + ", count " + len + ", length " + b.length);
+      }
+      Decoder d = new Decoder(cs);
+      char[] out = new char[maxChars(cs, len)];
+      int n = d.decode(b, off, len, out, 0, true);
+      if (n == out.length) {
+         return out;
+      }
+      char[] r = new char[n];
+      System.arraycopy(out, 0, r, 0, n);
+      return r;
+   }
+
+   private static int maxChars(int cs, int bytes) {
+      // UTF-8 never gives more chars than bytes; the UTF-16s give one per two (a lone byte gives one replacement)
+      return cs >= UTF16 ? bytes / 2 + 1 : bytes;
+   }
+
+   public static byte[] encode(int cs, char[] c, int off, int len) {
+      Encoder e = new Encoder(cs);
+      byte[] out = new byte[e.maxBytes(len)];
+      int n = e.encode(c, off, len, out, 0, true);
+      if (n == out.length) {
+         return out;
+      }
+      byte[] r = new byte[n];
+      System.arraycopy(out, 0, r, 0, n);
+      return r;
+   }
+
+   // ------------------------------------------------------------------ streaming
+
+   /** Decodes bytes that may come in pieces (a sequence cut between two calls is kept for the next). */
+   public static final class Decoder {
+      private final int cs;
+      private final byte[] pending = new byte[4];
+      private int npending;
+      /** UTF-16: the byte order once seen (true: little-endian), and whether the start was checked for a byte order mark. */
+      private boolean little;
+      private boolean started;
+
+      public Decoder(int cs) {
+         this.cs = cs;
+         this.little = cs == UTF16LE;
+      }
+
+      /** At most this many chars come out of len more bytes. */
+      public int maxChars(int len) {
+         return Coding.maxChars(cs, len + npending) + 1;
+      }
+
+      /**
+       * Decodes len bytes into out at outOff, returns the number of chars.
+       * With end false an incomplete sequence at the end waits for more bytes;
+       * with end true it becomes a replacement character.
+       */
+      public int decode(byte[] b, int off, int len, char[] out, int outOff, boolean end) {
+         byte[] in = b;
+         int start = off;
+         int stop = off + len;
+         if (npending > 0) {
+            in = new byte[npending + len];
+            System.arraycopy(pending, 0, in, 0, npending);
+            System.arraycopy(b, off, in, npending, len);
+            start = 0;
+            stop = in.length;
+            npending = 0;
+         }
+         switch (cs) {
+            case UTF8:
+               return utf8(in, start, stop, out, outOff, end);
+            case LATIN1: {
+               int n = outOff;
+               for (int i = start; i < stop; i++) {
+                  out[n++] = (char) (in[i] & 0xFF);
+               }
+               return n - outOff;
+            }
+            case ASCII: {
+               int n = outOff;
+               for (int i = start; i < stop; i++) {
+                  int v = in[i];
+                  out[n++] = v >= 0 ? (char) v : '�';
+               }
+               return n - outOff;
+            }
+            case CP1252: {
+               int n = outOff;
+               for (int i = start; i < stop; i++) {
+                  int v = in[i] & 0xFF;
+                  out[n++] = v >= 0x80 && v < 0xA0 ? CP1252_HIGH[v - 0x80] : (char) v;
+               }
+               return n - outOff;
+            }
+            default:
+               return utf16(in, start, stop, out, outOff, end);
+         }
+      }
+
+      private void keep(byte[] in, int from, int stop) {
+         npending = stop - from;
+         System.arraycopy(in, from, pending, 0, npending);
+      }
+
+      private int utf8(byte[] in, int i, int stop, char[] out, int outOff, boolean end) {
+         int n = outOff;
+         while (i < stop) {
+            int b1 = in[i];
+            if (b1 >= 0) {
+               out[n++] = (char) b1;
+               i++;
+               continue;
+            }
+            b1 &= 0xFF;
+            int need;
+            int min;
+            if (b1 >= 0xC2 && b1 <= 0xDF) {
+               need = 1;
+               min = 0x80;
+            } else if (b1 >= 0xE0 && b1 <= 0xEF) {
+               need = 2;
+               min = 0x800;
+            } else if (b1 >= 0xF0 && b1 <= 0xF4) {
+               need = 3;
+               min = 0x10000;
+            } else {
+               // a continuation byte or a lead that is never valid (C0, C1, F5..FF)
+               out[n++] = '�';
+               i++;
+               continue;
+            }
+            int cp = b1 & (0x3F >> need);
+            int j = i + 1;
+            boolean bad = false;
+            for (int k = 0; k < need; k++, j++) {
+               if (j >= stop) {
+                  break;
+               }
+               int c = in[j] & 0xFF;
+               // the second byte's range rules out overlongs, surrogates and > U+10FFFF (the maximal valid subpart)
+               int lo = 0x80;
+               int hi = 0xBF;
+               if (k == 0) {
+                  if (b1 == 0xE0) {
+                     lo = 0xA0;
+                  } else if (b1 == 0xED) {
+                     hi = 0x9F;
+                  } else if (b1 == 0xF0) {
+                     lo = 0x90;
+                  } else if (b1 == 0xF4) {
+                     hi = 0x8F;
+                  }
+               }
+               if (c < lo || c > hi) {
+                  bad = true;
+                  break;
+               }
+               cp = (cp << 6) | (c & 0x3F);
+            }
+            if (bad) {
+               out[n++] = '�';
+               i = j;
+               continue;
+            }
+            if (j - i < need + 1) {
+               // cut at the end of what came
+               if (!end) {
+                  keep(in, i, stop);
+                  return n - outOff;
+               }
+               out[n++] = '�';
+               i = stop;
+               continue;
+            }
+            if (cp < min) {
+               out[n++] = '�';
+            } else if (cp >= 0x10000) {
+               cp -= 0x10000;
+               out[n++] = (char) (0xD800 | (cp >> 10));
+               out[n++] = (char) (0xDC00 | (cp & 0x3FF));
+            } else {
+               out[n++] = (char) cp;
+            }
+            i = j;
+         }
+         return n - outOff;
+      }
+
+      private int utf16(byte[] in, int i, int stop, char[] out, int outOff, boolean end) {
+         int n = outOff;
+         if (!started && cs == UTF16) {
+            if (stop - i < 2 && !end) {
+               keep(in, i, stop);
+               return 0;
+            }
+            if (stop - i >= 2) {
+               int b0 = in[i] & 0xFF;
+               int b1 = in[i + 1] & 0xFF;
+               if (b0 == 0xFE && b1 == 0xFF) {
+                  little = false;
+                  i += 2;
+               } else if (b0 == 0xFF && b1 == 0xFE) {
+                  little = true;
+                  i += 2;
+               }
+            }
+         }
+         started = true;
+         while (stop - i >= 2) {
+            int b0 = in[i] & 0xFF;
+            int b1 = in[i + 1] & 0xFF;
+            out[n++] = (char) (little ? (b1 << 8) | b0 : (b0 << 8) | b1);
+            i += 2;
+         }
+         if (i < stop) {
+            if (!end) {
+               keep(in, i, stop);
+            } else {
+               out[n++] = '�';
+            }
+         }
+         return n - outOff;
+      }
+   }
+
+   /** Encodes chars that may come in pieces (a high surrogate at the end waits for its pair). */
+   public static final class Encoder {
+      private final int cs;
+      private char pendingHigh;
+      private boolean bomWritten;
+
+      public Encoder(int cs) {
+         this.cs = cs;
+      }
+
+      public int maxBytes(int chars) {
+         int n = chars + (pendingHigh != 0 ? 1 : 0);
+         switch (cs) {
+            case UTF8:
+               return n * 3 + 1;
+            case UTF16:
+               return n * 2 + 2;
+            case UTF16BE:
+            case UTF16LE:
+               return n * 2;
+            default:
+               return n;
+         }
+      }
+
+      public int encode(char[] c, int off, int len, byte[] out, int outOff, boolean end) {
+         int n = outOff;
+         if (cs == UTF16 && !bomWritten && len > 0) {
+            out[n++] = (byte) 0xFE;
+            out[n++] = (byte) 0xFF;
+            bomWritten = true;
+         }
+         int i = off;
+         int stop = off + len;
+         if (pendingHigh != 0) {
+            char h = pendingHigh;
+            pendingHigh = 0;
+            if (i < stop && Character.isLowSurrogate(c[i])) {
+               n = pair(h, c[i], out, n);
+               i++;
+            } else {
+               n = unpaired(h, out, n);
+            }
+         }
+         for (; i < stop; i++) {
+            char ch = c[i];
+            if (Character.isHighSurrogate(ch)) {
+               if (i + 1 < stop) {
+                  if (Character.isLowSurrogate(c[i + 1])) {
+                     n = pair(ch, c[i + 1], out, n);
+                     i++;
+                  } else {
+                     n = unpaired(ch, out, n);
+                  }
+               } else if (!end) {
+                  pendingHigh = ch;
+               } else {
+                  n = unpaired(ch, out, n);
+               }
+               continue;
+            }
+            if (Character.isLowSurrogate(ch)) {
+               n = unpaired(ch, out, n);
+               continue;
+            }
+            n = single(ch, out, n);
+         }
+         return n - outOff;
+      }
+
+      private int single(char ch, byte[] out, int n) {
+         switch (cs) {
+            case UTF8:
+               if (ch < 0x80) {
+                  out[n++] = (byte) ch;
+               } else if (ch < 0x800) {
+                  out[n++] = (byte) (0xC0 | (ch >> 6));
+                  out[n++] = (byte) (0x80 | (ch & 0x3F));
+               } else {
+                  out[n++] = (byte) (0xE0 | (ch >> 12));
+                  out[n++] = (byte) (0x80 | ((ch >> 6) & 0x3F));
+                  out[n++] = (byte) (0x80 | (ch & 0x3F));
+               }
+               return n;
+            case LATIN1:
+               out[n++] = ch < 0x100 ? (byte) ch : (byte) '?';
+               return n;
+            case ASCII:
+               out[n++] = ch < 0x80 ? (byte) ch : (byte) '?';
+               return n;
+            case CP1252:
+               out[n++] = cp1252(ch);
+               return n;
+            case UTF16LE:
+               out[n++] = (byte) ch;
+               out[n++] = (byte) (ch >> 8);
+               return n;
+            default:
+               out[n++] = (byte) (ch >> 8);
+               out[n++] = (byte) ch;
+               return n;
+         }
+      }
+
+      private static byte cp1252(char ch) {
+         if (ch < 0x80 || (ch >= 0xA0 && ch < 0x100)) {
+            return (byte) ch;
+         }
+         for (int k = 0; k < CP1252_HIGH.length; k++) {
+            if (CP1252_HIGH[k] == ch && ch != '�') {
+               return (byte) (0x80 + k);
+            }
+         }
+         return (byte) '?';
+      }
+
+      private int pair(char hi, char lo, byte[] out, int n) {
+         if (cs == UTF8) {
+            int cp = Character.toCodePoint(hi, lo);
+            out[n++] = (byte) (0xF0 | (cp >> 18));
+            out[n++] = (byte) (0x80 | ((cp >> 12) & 0x3F));
+            out[n++] = (byte) (0x80 | ((cp >> 6) & 0x3F));
+            out[n++] = (byte) (0x80 | (cp & 0x3F));
+            return n;
+         }
+         if (cs >= UTF16) {
+            n = single(hi, out, n);
+            return single(lo, out, n);
+         }
+         // one character the single-byte sets cannot hold: one '?'
+         out[n++] = (byte) '?';
+         return n;
+      }
+
+      private int unpaired(char ch, byte[] out, int n) {
+         if (cs >= UTF16) {
+            return single(ch, out, n);
+         }
+         out[n++] = (byte) '?';
+         return n;
+      }
+   }
