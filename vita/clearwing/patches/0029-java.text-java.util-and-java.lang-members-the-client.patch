diff --git a/runtime/src/java/text/NumberFormat.java b/runtime/src/java/text/NumberFormat.java
index ff8c17e..74c9cbf 100644
--- a/runtime/src/java/text/NumberFormat.java
+++ b/runtime/src/java/text/NumberFormat.java
@@ -30,16 +30,108 @@ public class NumberFormat extends Format  {
         throw new UnsupportedOperationException();
     }
 
+    private boolean groupingUsed;
+    private boolean parseIntegerOnly;
+
+    /** As the JDK's "#,##0.###" for a number instance: grouped thousands, fractions rounded half-even. */
     public String format(long number) {
-        return Long.toString(number);
+        return digits(number < 0, Long.toString(number).replace("-", ""), "");
     }
 
     public String format(double number) {
-        return Double.toString(number);
+        if (Double.isNaN(number))
+            return "NaN";
+        if (Double.isInfinite(number))
+            return number < 0 ? "-\u221E" : "\u221E";
+        boolean negative = number < 0 || (number == 0.0 && 1 / number < 0);
+        java.math.BigDecimal d = new java.math.BigDecimal(Double.toString(Math.abs(number)))
+                .setScale(maximumFractionDigits, RoundingMode.HALF_EVEN);
+        String plain = d.toPlainString();
+        int dot = plain.indexOf('.');
+        String integer = dot < 0 ? plain : plain.substring(0, dot);
+        String fraction = dot < 0 ? "" : plain.substring(dot + 1);
+        int keep = fraction.length();
+        while (keep > minimumFractionDigits && fraction.charAt(keep - 1) == '0')
+            keep--;
+        fraction = fraction.substring(0, keep);
+        // as the JDK, a negative number that rounds to zero keeps its sign ("-0")
+        return digits(negative, integer, fraction);
+    }
+
+    private String digits(boolean negative, String integer, String fraction) {
+        while (integer.length() > 1 && integer.charAt(0) == '0')
+            integer = integer.substring(1);
+        if (integer.equals("0") && minimumIntegerDigits == 0 && !fraction.isEmpty())
+            integer = "";
+        if (integer.length() > maximumIntegerDigits)
+            integer = integer.substring(integer.length() - maximumIntegerDigits);
+        StringBuilder in = new StringBuilder(integer);
+        while (in.length() < minimumIntegerDigits)
+            in.insert(0, '0');
+        StringBuilder sb = new StringBuilder();
+        if (negative)
+            sb.append('-');
+        String i = in.toString();
+        for (int k = 0; k < i.length(); k++) {
+            if (groupingUsed && k > 0 && (i.length() - k) % 3 == 0)
+                sb.append(',');
+            sb.append(i.charAt(k));
+        }
+        StringBuilder fr = new StringBuilder(fraction);
+        while (fr.length() < minimumFractionDigits)
+            fr.append('0');
+        if (fr.length() > 0)
+            sb.append('.').append(fr);
+        return sb.toString();
+    }
+
+    public boolean isGroupingUsed() {
+        return groupingUsed;
+    }
+
+    public void setGroupingUsed(boolean newValue) {
+        groupingUsed = newValue;
+    }
+
+    public boolean isParseIntegerOnly() {
+        return parseIntegerOnly;
+    }
+
+    public void setParseIntegerOnly(boolean value) {
+        parseIntegerOnly = value;
     }
 
     public static NumberFormat getInstance(Locale inLocale) {
-        return new NumberFormat();
+        return getNumberInstance(inLocale);
+    }
+
+    public static NumberFormat getInstance() {
+        return getNumberInstance(Locale.getDefault());
+    }
+
+    public static NumberFormat getNumberInstance() {
+        return getNumberInstance(Locale.getDefault());
+    }
+
+    public static NumberFormat getNumberInstance(Locale inLocale) {
+        NumberFormat f = new NumberFormat();
+        f.groupingUsed = true;
+        return f;
+    }
+
+    public static NumberFormat getIntegerInstance() {
+        return getIntegerInstance(Locale.getDefault());
+    }
+
+    public static NumberFormat getIntegerInstance(Locale inLocale) {
+        NumberFormat f = getNumberInstance(inLocale);
+        f.setMaximumFractionDigits(0);
+        f.parseIntegerOnly = true;
+        return f;
+    }
+
+    public static Locale[] getAvailableLocales() {
+        return new Locale[]{Locale.US};
     }
 
     /**
diff --git a/runtime/src/java/util/Base64.java b/runtime/src/java/util/Base64.java
new file mode 100644
index 0000000..e770adb
--- /dev/null
+++ b/runtime/src/java/util/Base64.java
@@ -0,0 +1,140 @@
+package java.util;
+
+/** RFC 4648 Base64, as java.util.Base64 (basic, URL-safe and MIME encoders and decoders). */
+public class Base64 {
+   private Base64() {
+   }
+
+   private static final char[] BASIC = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/".toCharArray();
+   private static final char[] URL = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_".toCharArray();
+
+   public static Encoder getEncoder() {
+      return new Encoder(BASIC, true, 0);
+   }
+
+   public static Encoder getUrlEncoder() {
+      return new Encoder(URL, true, 0);
+   }
+
+   public static Encoder getMimeEncoder() {
+      return new Encoder(BASIC, true, 76);
+   }
+
+   public static Decoder getDecoder() {
+      return new Decoder(false, false);
+   }
+
+   public static Decoder getUrlDecoder() {
+      return new Decoder(true, false);
+   }
+
+   public static Decoder getMimeDecoder() {
+      return new Decoder(false, true);
+   }
+
+   public static class Encoder {
+      private final char[] table;
+      private final boolean padding;
+      private final int lineLength;
+
+      private Encoder(char[] table, boolean padding, int lineLength) {
+         this.table = table;
+         this.padding = padding;
+         this.lineLength = lineLength;
+      }
+
+      public Encoder withoutPadding() {
+         return new Encoder(table, false, lineLength);
+      }
+
+      public String encodeToString(byte[] src) {
+         StringBuilder sb = new StringBuilder(4 * ((src.length + 2) / 3));
+         int line = 0;
+         for (int i = 0; i < src.length; i += 3) {
+            int b0 = src[i] & 0xFF;
+            int b1 = i + 1 < src.length ? src[i + 1] & 0xFF : 0;
+            int b2 = i + 2 < src.length ? src[i + 2] & 0xFF : 0;
+            if (lineLength > 0 && line == lineLength) {
+               sb.append("\r\n");
+               line = 0;
+            }
+            sb.append(table[b0 >> 2]);
+            sb.append(table[((b0 & 3) << 4) | (b1 >> 4)]);
+            if (i + 1 < src.length)
+               sb.append(table[((b1 & 15) << 2) | (b2 >> 6)]);
+            else if (padding)
+               sb.append('=');
+            if (i + 2 < src.length)
+               sb.append(table[b2 & 63]);
+            else if (padding)
+               sb.append('=');
+            line += 4;
+         }
+         return sb.toString();
+      }
+
+      public byte[] encode(byte[] src) {
+         String s = encodeToString(src);
+         byte[] b = new byte[s.length()];
+         for (int i = 0; i < b.length; i++)
+            b[i] = (byte) s.charAt(i);
+         return b;
+      }
+   }
+
+   public static class Decoder {
+      private final boolean url;
+      private final boolean mime;
+
+      private Decoder(boolean url, boolean mime) {
+         this.url = url;
+         this.mime = mime;
+      }
+
+      private int value(char c) {
+         if (c >= 'A' && c <= 'Z')
+            return c - 'A';
+         if (c >= 'a' && c <= 'z')
+            return c - 'a' + 26;
+         if (c >= '0' && c <= '9')
+            return c - '0' + 52;
+         if (c == (url ? '-' : '+'))
+            return 62;
+         if (c == (url ? '_' : '/'))
+            return 63;
+         return -1;
+      }
+
+      public byte[] decode(String src) {
+         java.io.ByteArrayOutputStream out = new java.io.ByteArrayOutputStream();
+         int bits = 0;
+         int count = 0;
+         int i = 0;
+         for (; i < src.length(); i++) {
+            char c = src.charAt(i);
+            if (c == '=')
+               break;
+            int v = value(c);
+            if (v < 0) {
+               if (mime)
+                  continue;
+               throw new IllegalArgumentException("Illegal base64 character " + Integer.toHexString(c));
+            }
+            bits = (bits << 6) | v;
+            count += 6;
+            if (count >= 8) {
+               count -= 8;
+               out.write((bits >> count) & 0xFF);
+            }
+         }
+         return out.toByteArray();
+      }
+
+      public byte[] decode(byte[] src) {
+         StringBuilder sb = new StringBuilder(src.length);
+         for (byte b : src)
+            sb.append((char) (b & 0xFF));
+         return decode(sb.toString());
+      }
+   }
+}
