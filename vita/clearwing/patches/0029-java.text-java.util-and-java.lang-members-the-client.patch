diff --git a/runtime/src/java/lang/management/ManagementFactory.java b/runtime/src/java/lang/management/ManagementFactory.java
new file mode 100644
index 0000000..20600dd
--- /dev/null
+++ b/runtime/src/java/lang/management/ManagementFactory.java
@@ -0,0 +1,84 @@
+package java.lang.management;
+
+/** The two beans the bridge asks for: the operating system's and the runtime's. */
+public class ManagementFactory {
+   private ManagementFactory() {
+   }
+
+   private static final OperatingSystemMXBean OS = new OperatingSystemMXBean() {
+      public String getName() {
+         return System.getProperty("os.name");
+      }
+
+      public String getArch() {
+         return System.getProperty("os.arch");
+      }
+
+      public String getVersion() {
+         String v = System.getProperty("os.version");
+         return v != null ? v : "";
+      }
+
+      public int getAvailableProcessors() {
+         return Runtime.getRuntime().availableProcessors();
+      }
+
+      public double getSystemLoadAverage() {
+         return -1.0;
+      }
+   };
+
+   private static final long START = System.currentTimeMillis();
+
+   private static final RuntimeMXBean RUNTIME = new RuntimeMXBean() {
+      public String getName() {
+         return pid() + "@" + host();
+      }
+
+      public long getUptime() {
+         return System.currentTimeMillis() - START;
+      }
+
+      public long getStartTime() {
+         return START;
+      }
+
+      public String getVmName() {
+         return System.getProperty("java.vm.name");
+      }
+
+      public String getVmVendor() {
+         return System.getProperty("java.vendor");
+      }
+
+      public String getVmVersion() {
+         return System.getProperty("java.version");
+      }
+
+      public String getSpecVersion() {
+         return System.getProperty("java.specification.version");
+      }
+
+      public java.util.List<String> getInputArguments() {
+         return new java.util.ArrayList<String>();
+      }
+   };
+
+   public static OperatingSystemMXBean getOperatingSystemMXBean() {
+      return OS;
+   }
+
+   public static RuntimeMXBean getRuntimeMXBean() {
+      return RUNTIME;
+   }
+
+   private static String host() {
+      try {
+         return java.net.InetAddress.getLocalHost().getHostName();
+      } catch (Exception e) {
+         return "localhost";
+      }
+   }
+
+   private static native long pid();
+}
